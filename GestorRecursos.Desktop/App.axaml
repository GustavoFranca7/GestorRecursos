<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GestorRecursos.Desktop.App"
             xmlns:local="using:GestorRecursos.Desktop"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Cores primeiro: todo o resto se apoia nelas. -->
                <ResourceInclude Source="/Styles/Cores.axaml" />
                <ResourceInclude Source="/Assets/Icones.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Textos do menu do botao direito (copiar, colar...) em portugues -->
            <x:String x:Key="StringTextFlyoutCutText">Recortar</x:String>
            <x:String x:Key="StringTextFlyoutCopyText">Copiar</x:String>
            <x:String x:Key="StringTextFlyoutPasteText">Colar</x:String>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Estilos usados por mais de uma tela: dado copiável, selo de placa... -->
        <StyleInclude Source="/Styles/Componentes.axaml" />
    </Application.Styles>
</Application>
