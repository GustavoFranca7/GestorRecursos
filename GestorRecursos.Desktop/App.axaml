<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GestorRecursos.Desktop.App"
             xmlns:local="using:GestorRecursos.Desktop"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Cores e fonte primeiro: o arquivo de botoes depende deles. -->
                <ResourceInclude Source="/Styles/Tema.axaml" />
                <ResourceInclude Source="/Styles/Botoes.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Textos do menu do botao direito (copiar, colar...) em portugues -->
            <x:String x:Key="StringTextFlyoutCutText">Recortar</x:String>
            <x:String x:Key="StringTextFlyoutCopyText">Copiar</x:String>
            <x:String x:Key="StringTextFlyoutPasteText">Colar</x:String>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Estilos compartilhados entre as telas (dicas, caixas de texto). -->
        <StyleInclude Source="/Styles/Geral.axaml" />
    </Application.Styles>
</Application>
