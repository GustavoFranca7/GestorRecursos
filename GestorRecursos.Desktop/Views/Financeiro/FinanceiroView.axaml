<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1290" d:DesignHeight="880"
             x:Class="GestorRecursos.Desktop.Views.FinanceiroView"
             x:DataType="vm:FinanceiroViewModel">

    <UserControl.Styles>
        <Style Selector="Border.cartao">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
        <Style Selector="TextBlock.titulocartao">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.7"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
        </Style>
        <Style Selector="TextBlock.numero">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.legenda">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
        </Style>
        <Style Selector="TextBlock.cabecalho">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Aba da seção: sublinhado, igual ao da ficha do cliente -->
        <Style Selector="Button.abasecao">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,9"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.abasecao /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
        </Style>
        <Style Selector="Button.abasecao:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
        </Style>
        <Style Selector="Button.abasecao:pointerover">
            <Setter Property="Foreground" Value="{StaticResource PrimariaEscura}"/>
        </Style>
        <Style Selector="Button.abasecao.escolhida">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimariaEscura}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Seta de mês: quadrada, discreta, do tamanho do texto ao lado -->
        <Style Selector="Button.mes">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.mes /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>
        <Style Selector="Button.mes:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimariaBorda}"/>
        </Style>
        <Style Selector="Button.mes:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,*" Margin="24,16,24,16">

            <!-- ============ AS DUAS ABAS ============ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Classes="abasecao" Content="Caixa"
                        Classes.escolhida="{Binding NoCaixa}"
                        Command="{Binding TrocarAbaCommand}"
                        CommandParameter="{x:Static vm:AbaFinanceiro.Caixa}"/>
                <Button Classes="abasecao" Content="Cobrança"
                        Classes.escolhida="{Binding NaCobranca}"
                        Command="{Binding TrocarAbaCommand}"
                        CommandParameter="{x:Static vm:AbaFinanceiro.Cobranca}"/>
            </StackPanel>

            <!-- ============ ABA CAIXA ============ -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding NoCaixa}">

                <!-- O mês, e o caminho para os outros -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10"
                            Margin="0,0,0,14" VerticalAlignment="Center">
                    <Button Classes="mes" Command="{Binding MesAnteriorCommand}"
                            ToolTip.Tip="Mês anterior">
                        <Viewbox Width="11" Height="11">
                            <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                  Data="{StaticResource IconeSetaEsquerda}"/>
                        </Viewbox>
                    </Button>
                    <TextBlock Text="{Binding TituloDoMes}" FontSize="17" FontWeight="SemiBold"
                               MinWidth="210" VerticalAlignment="Center"
                               Foreground="{StaticResource Texto}"/>
                    <Button Classes="mes" Command="{Binding MesSeguinteCommand}"
                            IsEnabled="{Binding PodeAvancar}"
                            ToolTip.Tip="Mês seguinte">
                        <Viewbox Width="11" Height="11">
                            <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                  Data="{StaticResource IconeSetaDireita}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Entrou, saiu, líquido e o que foi fechado -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,14">
                    <Border Grid.Column="0" Classes="cartao" Margin="0,0,10,0">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="numero" Text="{Binding Entrou}"
                                       Foreground="{StaticResource Sucesso}"/>
                            <TextBlock Classes="legenda" Text="entrou no mês"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="cartao" Margin="0,0,10,0">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="numero" Text="{Binding Saiu}"
                                       Foreground="{StaticResource Alerta}"/>
                            <TextBlock Classes="legenda" Text="saiu em despesas"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="cartao" Margin="0,0,10,0">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="numero" Text="{Binding Liquido}"
                                       Foreground="{StaticResource Texto}"/>
                            <TextBlock Classes="legenda" Text="líquido"/>
                        </StackPanel>
                    </Border>
                    <!-- Fechado no mês não é o mesmo que entrou: serviço de novembro pago
                         em dezembro conta aqui, e no caixa do mês que vem. -->
                    <Border Grid.Column="3" Classes="cartao">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="numero" Text="{Binding ValorFechado}"
                                       Foreground="{StaticResource PrimariaEscura}"/>
                            <TextBlock Classes="legenda" Text="{Binding Fechados}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Como o dinheiro entrou -->
                <Border Grid.Row="2" Classes="cartao" Margin="0,0,0,14"
                        IsVisible="{Binding PorForma.Count}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="titulocartao" Text="COMO O DINHEIRO ENTROU"/>
                        <ItemsControl ItemsSource="{Binding PorForma}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FatiaDaFormaViewModel">
                                    <Grid ColumnDefinitions="118,Auto,*" Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0" Text="{Binding Nome}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Texto}"/>
                                        <Border Grid.Column="1" Height="9"
                                                Width="{Binding Largura}"
                                                CornerRadius="5" VerticalAlignment="Center"
                                                Background="{StaticResource Primaria}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Valor}"
                                                   FontSize="12" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextoFraco}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- O extrato -->
                <Panel Grid.Row="3">
                    <Border Classes="cartao" Padding="0" VerticalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="96,2.4*,2*,1.2*,Auto"
                                  Margin="16,13,16,10">
                                <TextBlock Grid.Column="0" Classes="cabecalho" Text="QUANDO"/>
                                <TextBlock Grid.Column="1" Classes="cabecalho" Text="CLIENTE"/>
                                <TextBlock Grid.Column="2" Classes="cabecalho" Text="DESCRIÇÃO"/>
                                <TextBlock Grid.Column="3" Classes="cabecalho" Text="FORMA"/>
                                <TextBlock Grid.Column="4" Classes="cabecalho" Text="VALOR"
                                           MinWidth="110" TextAlignment="Right"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Movimentos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MovimentoViewModel">
                                            <Border BorderBrush="{StaticResource BordaClara}"
                                                    BorderThickness="0,1,0,0" Padding="16,10">
                                                <Grid ColumnDefinitions="96,2.4*,2*,1.2*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding DiaCurto}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextoFraco}"/>

                                                    <Button Grid.Column="1" Classes="copiavel"
                                                            Content="{Binding Nome}" FontSize="12.5"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource Texto}"
                                                            ToolTip.Tip="Clique para copiar o nome"
                                                            Command="{Binding $parent[ItemsControl].((vm:FinanceiroViewModel)DataContext).CopiarCommand}"
                                                            CommandParameter="{Binding Nome}"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding Descricao}"
                                                               FontSize="12" Margin="0,0,10,0"
                                                               IsVisible="{Binding TemDescricao}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextoFraco}"/>

                                                    <Border Grid.Column="3" DataContext="{Binding Selo}"
                                                            CornerRadius="{StaticResource RaioSelo}"
                                                            Padding="9,3" HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                                        <TextBlock Text="{Binding Texto}" FontSize="11"
                                                                   Foreground="{Binding ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="4" Text="{Binding Valor}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               MinWidth="110" TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CorDoValor, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock IsVisible="{Binding SemMovimentos}"
                               Text="Nenhum lançamento neste mês."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource TextoFraco}"/>
                </Panel>
            </Grid>

            <!-- ============ ABA COBRANÇA ============ -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding NaCobranca}">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                    <Border Grid.Column="0" Classes="cartao">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="numero" Text="{Binding TotalEmAberto}"
                                       Foreground="{StaticResource Alerta}"/>
                            <TextBlock Classes="legenda" Text="{Binding ResumoDaCobranca}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Panel Grid.Row="1" Width="420" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <TextBox Classes="busca" Text="{Binding TermoBusca}"
                             PlaceholderText="Buscar por cliente, CPF ou serviço"/>
                    <Button Command="{Binding LimparBuscaCommand}" Background="Transparent"
                            BorderThickness="0" Padding="8,0" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding TemBusca}" ToolTip.Tip="Limpar a busca">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                  Data="{StaticResource IconeFechar}"/>
                        </Viewbox>
                    </Button>
                    <Viewbox Width="15" Height="15" HorizontalAlignment="Right"
                             Margin="0,0,10,0" VerticalAlignment="Center"
                             IsVisible="{Binding !TemBusca}">
                        <Path Fill="{StaticResource TextoApagado}" Stretch="Uniform"
                              Data="{StaticResource IconeBusca}"/>
                    </Viewbox>
                </Panel>

                <Panel Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cobrancas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CobrancaViewModel">
                                    <Border Background="{StaticResource Cartao}"
                                            BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                            CornerRadius="{StaticResource RaioCartao}"
                                            Margin="0,0,0,7" ClipToBounds="True">
                                        <Grid ColumnDefinitions="4,*">
                                            <!-- Faixa vermelha no que já passou de 90 dias -->
                                            <Border Grid.Column="0" Background="{StaticResource Alerta}"
                                                    IsVisible="{Binding Antigo}"/>

                                            <Grid Grid.Column="1" ColumnDefinitions="2.4*,2.4*,1.3*,Auto"
                                                  Margin="14,12,14,12">

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <Button Classes="copiavel" Content="{Binding Nome}"
                                                            FontSize="13" FontWeight="SemiBold"
                                                            Foreground="{StaticResource Texto}"
                                                            ToolTip.Tip="Clique para copiar o nome"
                                                            Command="{Binding $parent[ItemsControl].((vm:FinanceiroViewModel)DataContext).CopiarCommand}"
                                                            CommandParameter="{Binding Nome}"/>
                                                    <Button Classes="copiavel secundario"
                                                            Content="{Binding WhatsappFormatado}"
                                                            ToolTip.Tip="Clique para copiar o WhatsApp"
                                                            Command="{Binding $parent[ItemsControl].((vm:FinanceiroViewModel)DataContext).CopiarCommand}"
                                                            CommandParameter="{Binding WhatsappFormatado}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Spacing="3" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Servicos}" FontSize="12"
                                                               IsVisible="{Binding TemServicos}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Texto}"/>
                                                    <!-- O histórico é o que decide o tom da conversa -->
                                                    <TextBlock Text="{Binding Historico}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" DataContext="{Binding SeloAtraso}"
                                                        CornerRadius="{StaticResource RaioSelo}"
                                                        Padding="9,3" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                                    <TextBlock Text="{Binding Texto}" FontSize="11"
                                                               Foreground="{Binding ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                </Border>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                            Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EmAberto}"
                                                               FontSize="14.5" FontWeight="SemiBold"
                                                               MinWidth="104" TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Alerta}"/>

                                                    <Button Classes="primario" FontSize="11.5"
                                                            Padding="12,7" Content="Receber"
                                                            ToolTip.Tip="Lançar o pagamento desta contratação"
                                                            Command="{Binding $parent[ItemsControl].((vm:FinanceiroViewModel)DataContext).ReceberCommand}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Classes="acao"
                                                            ToolTip.Tip="Abrir a ficha do cliente"
                                                            Command="{Binding $parent[ItemsControl].((vm:FinanceiroViewModel)DataContext).AbrirClienteCommand}"
                                                            CommandParameter="{Binding ClienteId}">
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                                                  Data="{StaticResource IconePasta}"/>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock IsVisible="{Binding SemCobrancas}"
                               Text="{Binding MensagemSemCobrancas}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               FontSize="13" Foreground="{StaticResource TextoFraco}"/>
                </Panel>
            </Grid>
        </Grid>

        <TextBlock IsVisible="{Binding Carregando}"
                   Text="Carregando o financeiro..."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource TextoFraco}"/>

        <!-- Erro fica na tela até alguém resolver: não é aviso que se apaga sozinho -->
        <Border Margin="24" VerticalAlignment="Top"
                IsVisible="{Binding Erro, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                Background="{StaticResource AlertaClaro}"
                BorderBrush="{StaticResource AlertaBorda}" BorderThickness="1"
                CornerRadius="{StaticResource RaioCartao}" Padding="16,13">
            <TextBlock Text="{Binding Erro}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource AlertaEscuro}"/>
        </Border>

        <!-- O formulário de pagamento, por cima de tudo -->
        <ContentControl Content="{Binding Formulario}"
                        IsVisible="{Binding Formulario, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
    </Panel>
</UserControl>
