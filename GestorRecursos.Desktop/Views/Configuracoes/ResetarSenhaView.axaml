<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="GestorRecursos.Desktop.Views.ResetarSenhaView"
             x:DataType="vm:ResetarSenhaViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.entrada">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFCFC"/>
        </Style>
        <Style Selector="TextBox.entrada:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#66102A2C">
        <Border Background="{StaticResource Cartao}"
                CornerRadius="{StaticResource RaioCartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="1"
                Padding="28,24" Width="420"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 14 40 0 #30102A2C">

            <StackPanel Spacing="16">

                <StackPanel Spacing="4">
                    <TextBlock Text="Redefinir senha" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Texto}"/>
                    <TextBlock Text="{Binding Alvo}" FontSize="12.5"
                               Foreground="{StaticResource TextoFraco}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="rotulo" Text="Senha provisória"/>
                    <TextBox Classes="entrada" Text="{Binding SenhaProvisoria}"
                             Watermark="Pelo menos 6 caracteres"/>
                    <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               LineHeight="16"
                               Foreground="{StaticResource TextoApagado}"
                               Text="Vale para um único acesso. O e-mail de recuperação é apagado, e a definição de senha pessoal volta a ser exigida na entrada."/>
                </StackPanel>

                <Border IsVisible="{Binding Erro, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                        Background="{StaticResource AlertaClaro}"
                        BorderBrush="{StaticResource AlertaBorda}" BorderThickness="1"
                        CornerRadius="{StaticResource RaioBotao}" Padding="13,10">
                    <TextBlock Text="{Binding Erro}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Alerta}"/>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="neutro" Content="Cancelar"
                            Command="{Binding CancelarCommand}"/>
                    <Button Classes="primario" Content="Redefinir"
                            IsEnabled="{Binding !Ocupado}"
                            Command="{Binding ConfirmarCommand}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
