<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="GestorRecursos.Desktop.Views.ConfiguracoesView"
             x:DataType="vm:ConfiguracoesViewModel">

    <UserControl.Styles>
        <Style Selector="Border.cartao">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style Selector="TextBlock.titulocartao">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextoApagado}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24" Spacing="14" MaxWidth="900"
                        HorizontalAlignment="Left">

                <!-- Quem não administra vê Configurações, mas não esta aba -->
                <Border Classes="cartao" IsVisible="{Binding !PodeAdministrar}" Padding="24,28">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Nada para ajustar por aqui, por enquanto."
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextoFraco}"/>
                        <TextBlock FontSize="11.5" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                   Foreground="{StaticResource TextoApagado}"
                                   Text="Os dados do escritório, que alimentam a procuração, entram nesta tela em breve."/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="14" IsVisible="{Binding PodeAdministrar}">

                    <Border Classes="cartao">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Usuários" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Texto}"/>
                                <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextoApagado}"
                                           Text="Acessos ao sistema. Cada acesso recebe uma senha provisória e exige a definição de senha pessoal no primeiro uso."/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primario" Content="+ Novo acesso"
                                    VerticalAlignment="Center" Margin="14,0,0,0"
                                    Command="{Binding NovoUsuarioCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Copiável: a senha provisória costuma ser repassada por mensagem, e
                         redigitar à mão erra. -->
                    <Border Classes="cartao"
                            IsVisible="{Binding Aviso, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                            Background="{StaticResource PrimariaClara}"
                            BorderBrush="{StaticResource PrimariaBorda}">
                        <Button Classes="copiavel" Padding="0" Background="Transparent"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="Clique para copiar"
                                Command="{Binding CopiarCommand}"
                                CommandParameter="{Binding Aviso}">
                            <TextBlock Text="{Binding Aviso}" FontSize="12.5" TextWrapping="Wrap"
                                       LineHeight="19"
                                       Foreground="{StaticResource PrimariaEscura}"/>
                        </Button>
                    </Border>

                    <Border Classes="cartao"
                            IsVisible="{Binding Erro, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                            Background="{StaticResource AlertaClaro}"
                            BorderBrush="{StaticResource AlertaBorda}">
                        <TextBlock Text="{Binding Erro}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource Alerta}"/>
                    </Border>

                    <Border Classes="cartao" IsVisible="{Binding !SemUsuarios}">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="titulocartao" Text="ACESSOS"/>

                            <ItemsControl ItemsSource="{Binding Usuarios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinhaUsuarioViewModel">
                                        <Border BorderBrush="{StaticResource BordaClara}"
                                                BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                                                <StackPanel Grid.Column="0" Spacing="3"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Nome}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Texto}"/>
                                                        <TextBlock Text="{Binding Papel}" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding EhAdministrador}"
                                                                   Foreground="{StaticResource Primaria}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Login}" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="10,0" Padding="9,3"
                                                        CornerRadius="{StaticResource RaioSelo}"
                                                        Background="{Binding FundoSelo, Converter={x:Static vm:Conversores.Pincel}}">
                                                    <TextBlock Text="{Binding Situacao}" FontSize="11"
                                                               Foreground="{Binding CorSelo, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                </Border>

                                                <Button Grid.Column="2" Classes="atalhocartao"
                                                        Content="resetar senha"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        ToolTip.Tip="Devolve o acesso com uma senha provisória"
                                                        Command="{Binding $parent[ItemsControl].((vm:ConfiguracoesViewModel)DataContext).ResetarCommand}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="3" Classes="atalhocartao"
                                                        Content="{Binding AcaoAtivo}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].((vm:ConfiguracoesViewModel)DataContext).MudarAtivoCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock IsVisible="{Binding Carregando}" Text="Carregando os acessos..."
                               FontSize="13" Foreground="{StaticResource TextoFraco}"/>

                    <!-- Os documentos ficam no banco, e o backup semanal só leva texto:
                         sem esta exportação eles não têm cópia nenhuma fora da nuvem. -->
                    <Border Classes="cartao">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Documentos dos clientes" FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Texto}"/>
                                <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{StaticResource TextoApagado}"
                                           Text="Grava em disco tudo o que foi anexado às fichas, em uma pasta por cliente. O backup semanal guarda só o texto do sistema — esta é a cópia dos documentos."/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primario" Content="Exportar"
                                    VerticalAlignment="Center" Margin="14,0,0,0"
                                    Command="{Binding ExportarDocumentosCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentControl Content="{Binding Formulario}"
                        IsVisible="{Binding Formulario, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>

        <ContentControl Content="{Binding Redefinicao}"
                        IsVisible="{Binding Redefinicao, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>

        <ContentControl Content="{Binding Exportacao}"
                        IsVisible="{Binding Exportacao, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>

        <ContentControl Content="{Binding Confirmacao}"
                        IsVisible="{Binding Confirmacao, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
    </Panel>
</UserControl>
