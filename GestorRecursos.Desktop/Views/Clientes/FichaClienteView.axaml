<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1290" d:DesignHeight="880"
             x:Class="GestorRecursos.Desktop.Views.FichaClienteView"
             x:DataType="vm:FichaClienteViewModel">

    <UserControl.Resources>
        <!-- Um template só para os três cartões de campos: eles diferem no conteúdo,
             não na forma, e copiar precisa funcionar igual nos três. -->
        <DataTemplate x:Key="CampoTemplate" x:DataType="vm:CampoFicha">
            <!-- Sem coluna para dica de "copiar": invisível ela continuava ocupando
                 espaço e empurrava os valores para longe da borda direita. O realce, o
                 cursor e o tooltip já dizem que dá para clicar. -->
            <Button Classes="copiavel campo" IsEnabled="{Binding Preenchido}"
                    ToolTip.Tip="Clique para copiar"
                    Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                    CommandParameter="{Binding Valor}">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding Rotulo}" FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextoFraco}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="12.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                               Foreground="{Binding Preenchido, Converter={x:Static vm:Conversores.CorDoCampo}}"
                               FontStyle="{Binding Preenchido, Converter={x:Static vm:Conversores.EstiloDoCampo}}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A linha do campo é um dado copiável que ocupa a largura do cartão: herda
             tudo de Button.copiavel (Styles/Componentes.axaml) e só se estica.

             Sem margem negativa: com ela o botão transbordava o cartão, que recorta —
             e o recorte comia justamente os cantos arredondados do realce. -->
        <Style Selector="Button.campo">
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Aba da ficha: sublinhado, sem cápsula -->
        <Style Selector="Button.abaficha">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,9"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.abaficha:pointerover">
            <Setter Property="Foreground" Value="{StaticResource PrimariaEscura}"/>
        </Style>
        <Style Selector="Button.abaficha:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.abaficha.escolhida">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimariaEscura}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.abaficha /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
        </Style>
        <Style Selector="Button.abaficha:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
        </Style>

        <!-- Cartão de informação -->
        <Style Selector="Border.cartao">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}"/>
            <Setter Property="Padding" Value="18,15"/>
        </Style>
        <Style Selector="TextBlock.titulocartao">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.7"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
        </Style>

        <!-- Linha do roteiro de um serviço direto -->
        <Style Selector="Button.etapa">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.etapa /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.etapa:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
        </Style>
        <!-- Etapa cumprida sai de cena sem sumir: ela ainda explica o que já foi feito -->
        <Style Selector="TextBlock.cumprida">
            <Setter Property="Foreground" Value="{StaticResource TextoApagado}"/>
        </Style>

        <!-- Coluna de uma fase do recurso: autuação, JARI ou CETRAN -->
        <Style Selector="Border.fase">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaClara}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- A fase que está aberta é onde mora o trabalho: ela ganha a borda forte -->
        <Style Selector="Border.fase.atual">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
        </Style>
        <Style Selector="Border.fase.urgente">
            <Setter Property="BorderBrush" Value="{StaticResource Alerta}"/>
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
        </Style>
        <Style Selector="Border.fase.vazia">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaClara}"/>
        </Style>
        <Style Selector="TextBlock.nomefase">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>
        <Style Selector="TextBlock.detalhefase">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Cabeçalho da tabela de multas -->
        <Style Selector="TextBlock.colunamulta">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoApagado}"/>
        </Style>

        <!-- Cliente na lista do lado -->
        <Style Selector="Button.vizinho">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <!-- Repouso escrito, e não herdado: ao trocar de cliente a classe "aberta" sai de
             todos ao mesmo tempo, e sem um fundo definido a animação do tema passa pelo
             preto — era o que fazia a lista inteira piscar. -->
        <Style Selector="Button.vizinho /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cartao}"/>
        </Style>
        <Style Selector="Button.vizinho:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CartaoSuave}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>
        <Style Selector="Button.vizinho.aberta /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimariaBorda}"/>
        </Style>


        <Style Selector="TextBox.filtro">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="296,*">

        <!-- ===================== LISTA REDUZIDA ===================== -->
        <!-- Fica junto porque o escritório trabalha em sequência: trocar de cliente não
             deveria custar voltar para a listagem e procurar o lugar de novo. -->
        <Border Grid.Column="0" Background="{StaticResource Cartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,18,16,12">

                <!-- No lugar do rótulo "Clientes": é a única ação que faz falta aqui. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0" Classes="primario" Content="+ Novo cliente"
                            FontSize="11.5" Padding="11,6"
                            Command="{Binding NovoClienteCommand}"/>
                    <Button Grid.Column="1" Classes="neutro" Content="← Expandir lista"
                            FontSize="11.5" Padding="10,6" Margin="8,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding VoltarCommand}"
                            ToolTip.Tip="Voltar para a listagem inteira"/>
                </Grid>

                <TextBox Grid.Row="1" Classes="filtro" Margin="0,12,0,10"
                         Text="{Binding FiltroDaLista}"
                         PlaceholderText="Filtrar nesta lista...">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FiltrarListaCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="AoRolarVizinhos">
                    <ItemsControl ItemsSource="{Binding Vizinhos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinhaReduzidaViewModel">
                                <Button Classes="vizinho" Classes.aberta="{Binding Aberta}"
                                        Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).AbrirVizinhoCommand}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Nome}" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Texto}"/>
                                        <TextBlock Text="{Binding Detalhe}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                            <Border IsVisible="{Binding TemPlaca}"
                                                    Background="{StaticResource PrimariaClara}"
                                                    BorderBrush="{StaticResource PrimariaBorda}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RaioBotao}"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding PrimeiraPlaca}" FontSize="10.5"
                                                           FontFamily="Consolas,monospace"
                                                           Foreground="{StaticResource PrimariaEscura}"/>
                                            </Border>
                                            <Border CornerRadius="{StaticResource RaioSelo}" Padding="7,2"
                                                    Background="{Binding DevendoAlgo, Converter={x:Static vm:Conversores.FundoDoSaldo}}">
                                                <TextBlock Text="{Binding Situacao}" FontSize="10.5"
                                                           Foreground="{Binding DevendoAlgo, Converter={x:Static vm:Conversores.CorDoSaldo}}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Text="{Binding ContagemDaLista}" FontSize="11"
                           Margin="2,10,0,0" Foreground="{StaticResource TextoApagado}"/>
            </Grid>
        </Border>

        <!-- ===================== FICHA ===================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,0">
                <StackPanel Grid.Column="0" Spacing="6">
                    <Button Classes="copiavel sobrefundo" Content="{Binding Nome}"
                            FontSize="21" FontWeight="Bold" Margin="-5,0,0,0"
                            Foreground="{StaticResource Texto}"
                            ToolTip.Tip="Clique para copiar o nome"
                            Command="{Binding CopiarCommand}"
                            CommandParameter="{Binding Nome}"/>
                    <!--<TextBlock Text="{Binding Identificacao}" FontSize="12"
                               Foreground="{StaticResource TextoFraco}"/>-->

                    <ItemsControl ItemsSource="{Binding Selos}" Margin="0,3,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeloViewModel">
                                <Border CornerRadius="{StaticResource RaioSelo}"
                                        Padding="9,3" Margin="0,2,6,2"
                                        Background="{Binding ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                    <TextBlock Text="{Binding Texto}" FontSize="11"
                                               Foreground="{Binding ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Editar e Nova contratação saíram daqui. Ficaram o "+ Novo recurso",
                     que é a ação do dia a dia, e a lixeira, que manda o cliente
                     para Arquivados. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Top">
                    <Button Classes="primario" Content="+ Novo serviço"
                            Command="{Binding NovoServicoCommand}"
                            ToolTip.Tip="Contratar um serviço para este cliente"/>

                    <Button Classes="acao perigosa"
                            Command="{Binding PedirArquivamentoCommand}"
                            ToolTip.Tip="Mover este cliente para Arquivados">
                        <Viewbox Width="15" Height="15">
                            <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                  Data="{StaticResource IconeExcluir}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Abas -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1"
                    Margin="24,16,24,0">
                <ItemsControl ItemsSource="{Binding Abas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AbaFichaViewModel">
                            <Button Classes="abaficha" Classes.escolhida="{Binding Escolhida}"
                                    IsEnabled="{Binding Pronta}"
                                    Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).TrocarAbaCommand}"
                                    CommandParameter="{Binding Aba}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center"/>
                                    <Border IsVisible="{Binding TemContador}"
                                            Background="{StaticResource BordaClara}"
                                            CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Contador}" FontSize="10.5"
                                                   Foreground="{StaticResource TextoFraco}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Conteúdo da aba -->
            <Panel Grid.Row="2">

                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding AbaDados}">
                    <StackPanel Margin="24,18,24,20" Spacing="14">

                        <!-- Duas colunas de cartões -->
                        <Grid ColumnDefinitions="*,14,*">
                            <StackPanel Grid.Column="0" Spacing="14">
                                <!-- Cada cartão abre a edição no grupo dele, mas lá dentro
                                     dá para trocar de grupo sem salvar e voltar. -->
                                <Border Classes="cartao">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="titulocartao" Text="DADOS PESSOAIS"/>
                                            <Button Grid.Column="1" Classes="atalhocartao" Content="editar"
                                                    Command="{Binding EditarCommand}"
                                                    CommandParameter="{x:Static vm:GrupoCadastro.DadosPessoais}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DadosPessoais}"
                                                      ItemTemplate="{StaticResource CampoTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="cartao">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="titulocartao" Text="CNH"/>
                                            <Button Grid.Column="1" Classes="atalhocartao" Content="editar"
                                                    Command="{Binding EditarCommand}"
                                                    CommandParameter="{x:Static vm:GrupoCadastro.Cnh}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DadosCnh}"
                                                      ItemTemplate="{StaticResource CampoTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="14">
                                <Border Classes="cartao">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="titulocartao"
                                                       Text="CONTATO E ENDEREÇO"/>
                                            <Button Grid.Column="1" Classes="atalhocartao" Content="editar"
                                                    Command="{Binding EditarCommand}"
                                                    CommandParameter="{x:Static vm:GrupoCadastro.ContatoEndereco}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding ContatoEndereco}"
                                                      ItemTemplate="{StaticResource CampoTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="cartao">
                                    <StackPanel Spacing="12">
                                        <!-- Aqui é resumo: veículo se cadastra na aba Veículos e multas,
                                             que é onde ele vive junto das multas dele. -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="titulocartao" Text="VEÍCULOS"/>
                                            <Button Grid.Column="1" Classes="atalhocartao" Content="ver todos"
                                                    Command="{Binding TrocarAbaCommand}"
                                                    CommandParameter="{x:Static vm:AbaFicha.Veiculos}"/>
                                        </Grid>

                                        <TextBlock IsVisible="{Binding !TemVeiculos}" FontSize="12"
                                                   Text="Nenhum veículo ligado a este cliente."
                                                   Foreground="{StaticResource TextoApagado}"/>

                                        <ItemsControl ItemsSource="{Binding Veiculos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VeiculoDaFichaViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <!-- A placa é o dado mais copiado do sistema -->
                                                            <Button Classes="copiavel placa" Content="{Binding Placa}"
                                                                    ToolTip.Tip="Clique para copiar a placa"
                                                                    Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                                                                    CommandParameter="{Binding Placa}"/>
                                                            <TextBlock Text="{Binding Descricao}" FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextoApagado}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Center"
                                                                CornerRadius="{StaticResource RaioSelo}" Padding="9,3"
                                                                Background="{Binding TemMultas, Converter={x:Static vm:Conversores.FundoDoSaldo}}">
                                                            <TextBlock Text="{Binding Multas}" FontSize="11"
                                                                       Foreground="{Binding TemMultas, Converter={x:Static vm:Conversores.CorDoSaldo}}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Observações: o que não cabe em campo nenhum -->
                        <Border Classes="cartao">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="titulocartao" Text="OBSERVAÇÕES"/>
                                    <Button Grid.Column="1" Classes="atalhocartao" Content="editar"
                                            Command="{Binding EditarCommand}"
                                            CommandParameter="{x:Static vm:GrupoCadastro.Observacoes}"/>
                                </Grid>

                                <TextBlock IsVisible="{Binding !TemObservacoes}" FontSize="12"
                                           Text="Nenhuma observação registrada."
                                           Foreground="{StaticResource TextoApagado}"/>

                                <TextBlock IsVisible="{Binding TemObservacoes}" FontSize="12.5"
                                           Text="{Binding Observacoes}" TextWrapping="Wrap"
                                           LineHeight="19" Foreground="{StaticResource Texto}"/>
                            </StackPanel>
                        </Border>

                        <!-- Processos em andamento -->
                        <Border Classes="cartao">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="titulocartao"
                                               Text="PROCESSOS EM ANDAMENTO"/>
                                    <Button Grid.Column="1" Classes="atalhocartao" Content="ver todos"
                                            Command="{Binding TrocarAbaCommand}"
                                            CommandParameter="{x:Static vm:AbaFicha.Servicos}"/>
                                </Grid>

                                <TextBlock IsVisible="{Binding !TemProcessos}" FontSize="12"
                                           Text="Nenhum processo em andamento."
                                           Foreground="{StaticResource TextoApagado}"/>

                                <ItemsControl ItemsSource="{Binding Processos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProcessoDaFichaViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,11">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <!-- Copia o AIT junto com o nome do serviço -->
                                                    <Button Classes="copiavel titulo" Content="{Binding Titulo}"
                                                            ToolTip.Tip="Clique para copiar"
                                                            Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                                                            CommandParameter="{Binding Titulo}"/>
                                                    <TextBlock Text="{Binding Detalhe}" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" VerticalAlignment="Center"
                                                        Background="{StaticResource RoxoClaro}"
                                                        CornerRadius="{StaticResource RaioSelo}"
                                                        Padding="9,3" Margin="8,0">
                                                    <TextBlock Text="{Binding Fase}" FontSize="11"
                                                               Foreground="{StaticResource Roxo}"/>
                                                </Border>

                                                <Border Grid.Column="2" DataContext="{Binding SeloPrazo}"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="{StaticResource RaioSelo}" Padding="9,3"
                                                        Background="{Binding ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                                    <TextBlock Text="{Binding Texto}" FontSize="11"
                                                               Foreground="{Binding ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Resumo financeiro: contratado → pago → em aberto -->
                        <Border Classes="cartao">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="titulocartao" Text="RESUMO FINANCEIRO"/>
                                    <!-- Só aparece quando a aba existir: atalho que não leva a lugar nenhum confunde -->
                                    <Button Grid.Column="1" Classes="atalhocartao" Content="ver lançamentos"
                                            IsVisible="{Binding FinanceiroPronto}"
                                            Command="{Binding TrocarAbaCommand}"
                                            CommandParameter="{x:Static vm:AbaFicha.Financeiro}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,34,0">
                                        <TextBlock Text="{Binding TotalContratado}" FontSize="19"
                                                   FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                        <TextBlock Text="TOTAL CONTRATADO" FontSize="9.5"
                                                   LetterSpacing="0.5"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,34,0">
                                        <TextBlock Text="{Binding JaPago}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{StaticResource Sucesso}"/>
                                        <TextBlock Text="JÁ PAGO" FontSize="9.5" LetterSpacing="0.5"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,34,0">
                                        <TextBlock Text="{Binding EmAberto}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{StaticResource Alerta}"/>
                                        <TextBlock Text="EM ABERTO" FontSize="9.5" LetterSpacing="0.5"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding PercentualQuitado}"
                                                     IsVisible="{Binding TemContratacao}"
                                                     Height="8" CornerRadius="4"
                                                     Foreground="{StaticResource Sucesso}"
                                                     Background="{StaticResource BordaClara}"/>
                                        <TextBlock Text="{Binding NotaDoFinanceiro}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ ABA VEÍCULOS E MULTAS ============ -->
                <!-- Um cartão por veículo, com as multas dele na tabela de baixo. A multa
                     pertence ao carro, e é assim que a informação chega do DETRAN. -->
                <!-- Sem rolagem horizontal de proposito: com ela o ScrollViewer mede o conteudo
                     como se a largura fosse infinita, e as colunas * param de encolher. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding AbaVeiculos}">
                    <StackPanel Margin="24,18,24,20" Spacing="14">

                        <ItemsControl ItemsSource="{Binding VeiculosEMultas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VeiculoComMultasViewModel">
                                    <Border Classes="cartao" Margin="0,0,0,14">
                                        <StackPanel Spacing="12">

                                            <!-- Identificação do veículo -->
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- A placa é o nome do carro: destaque para ela,
                                                         e o resto da descrição em voz baixa. -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                                                        <Button Classes="copiavel placagrande"
                                                                Content="{Binding Placa}"
                                                                ToolTip.Tip="Copiar placa"
                                                                Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                                                                CommandParameter="{Binding Placa}"/>
                                                        <TextBlock Text="{Binding Descricao}" FontSize="12.5"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                        <TextBlock Text="{Binding Ano}" FontSize="12"
                                                                   IsVisible="{Binding TemAno}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                Spacing="2" VerticalAlignment="Center">
                                                        <Button Classes="atalhoicone"
                                                                ToolTip.Tip="Editar veículo"
                                                                Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).EditarVeiculoCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Viewbox Width="15" Height="15">
                                                                <Path Fill="{StaticResource Primaria}" Stretch="Uniform"
                                                                      Data="{StaticResource IconeEditar}"/>
                                                            </Viewbox>
                                                        </Button>

                                                        <!-- Desvincular, não excluir: o carro pode ser de
                                                             outro cliente e as multas são dele. -->
                                                        <Button Classes="atalhoicone perigosa"
                                                                ToolTip.Tip="Desvincular este veículo do cliente"
                                                                Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).PedirDesvinculoCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Viewbox Width="12" Height="12">
                                                                <Path Fill="{StaticResource TextoApagado}" Stretch="Uniform"
                                                                      Data="{StaticResource IconeFechar}"/>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="18">
                                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                                IsVisible="{Binding TemRenavam}">
                                                        <TextBlock Text="RENAVAM" FontSize="10.5"
                                                                   LetterSpacing="0.4" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                        <Button Classes="copiavel"
                                                                Content="{Binding Renavam}" FontSize="12"
                                                                ToolTip.Tip="Clique para copiar o RENAVAM"
                                                                Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                                                                CommandParameter="{Binding Renavam}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="Vínculo" FontSize="12"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                        <TextBlock Text="{Binding Vinculo}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextoFraco}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="Multas" FontSize="12"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                        <TextBlock Text="{Binding ResumoMultas}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextoFraco}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Observacao}" FontSize="11.5"
                                                           IsVisible="{Binding TemObservacao}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextoApagado}"/>
                                            </StackPanel>

                                            <!-- Multas do veículo -->
                                            <StackPanel IsVisible="{Binding TemMultas}" Spacing="0">
                                                <Border BorderBrush="{StaticResource BordaClara}"
                                                        BorderThickness="0,1,0,1" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Texto cresce com a tela; selo e número têm tamanho próprio.
                                                                 MinWidth impede a coluna de sumir em tela estreita. -->
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="1.3*" MinWidth="140"/>
                                                            <ColumnDefinition Width="1.1*" MinWidth="130"/>
                                                            <ColumnDefinition Width="104"/>
                                                            <ColumnDefinition Width="88"/>
                                                            <ColumnDefinition Width="68"/>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Classes="colunamulta" Text="AIT"/>
                                                        <TextBlock Grid.Column="1" Classes="colunamulta" Text="INFRAÇÃO"/>
                                                        <TextBlock Grid.Column="2" Classes="colunamulta" Text="LOCAL E DATA"/>
                                                        <TextBlock Grid.Column="3" Classes="colunamulta" Text="GRAVIDADE"/>
                                                        <!-- O espaçamento entre letras sobra depois da última,
                                                             e era o que desencontrava o título do número. -->
                                                        <TextBlock Grid.Column="4" Classes="colunamulta" Text="VALOR"
                                                                   TextAlignment="Right" LetterSpacing="0"/>
                                                        <TextBlock Grid.Column="5" Classes="colunamulta" Text="PRAZO"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Classes="colunamulta" Text="SITUAÇÃO"
                                                                   HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="7" Classes="colunamulta" Text="AÇÃO"
                                                                   HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Multas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MultaViewModel">
                                                            <Border BorderBrush="{StaticResource BordaClara}"
                                                                    BorderThickness="0,0,0,1" Padding="0,10">
                                                                <!-- Mesmas larguras do cabeçalho: mudar uma, mudar as duas -->
                                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Texto cresce com a tela; selo e número têm tamanho próprio.
                                                                 MinWidth impede a coluna de sumir em tela estreita. -->
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="1.3*" MinWidth="140"/>
                                                            <ColumnDefinition Width="1.1*" MinWidth="130"/>
                                                            <ColumnDefinition Width="104"/>
                                                            <ColumnDefinition Width="88"/>
                                                            <ColumnDefinition Width="68"/>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Classes="copiavel placa"
                                                                            Content="{Binding Ait}"
                                                                            VerticalAlignment="Top"
                                                                            ToolTip.Tip="Clique para copiar o AIT"
                                                                            Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                                                                            CommandParameter="{Binding Ait}"/>

                                                                    <StackPanel Grid.Column="1" Spacing="2"
                                                                                Margin="0,0,14,0">
                                                                        <TextBlock Text="{Binding Enquadramento}"
                                                                                   FontSize="12.5"
                                                                                   Foreground="{StaticResource Texto}"/>
                                                                        <TextBlock Text="{Binding Descricao}"
                                                                                   IsVisible="{Binding TemDescricao}"
                                                                                   FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Spacing="2"
                                                                                Margin="0,0,14,0">
                                                                        <TextBlock Text="{Binding Local}" FontSize="12"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource TextoFraco}"/>
                                                                        <TextBlock Text="{Binding DataHora}" FontSize="11"
                                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="3" IsVisible="{Binding TemGravidade}"
                                                                            CornerRadius="{StaticResource RaioSelo}"
                                                                            Padding="8,3" HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Background="{Binding SeloGravidade.ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                                                        <TextBlock Text="{Binding SeloGravidade.Texto}"
                                                                                   FontSize="11"
                                                                                   Foreground="{Binding SeloGravidade.ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                    </Border>

                                                                    <TextBlock Grid.Column="4" Text="{Binding Valor}"
                                                                               FontSize="12.5" FontWeight="SemiBold"
                                                                               TextAlignment="Right"
                                                                               VerticalAlignment="Top"
                                                                               Foreground="{StaticResource Texto}"/>

                                                                    <Border Grid.Column="5"
                                                                            CornerRadius="{StaticResource RaioSelo}"
                                                                            Padding="8,3" Margin="4,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            Background="{Binding SeloPrazo.ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                                                        <TextBlock Text="{Binding SeloPrazo.Texto}"
                                                                                   FontSize="11"
                                                                                   Foreground="{Binding SeloPrazo.ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                    </Border>

                                                                    <Border Grid.Column="6" IsVisible="{Binding TemSituacao}"
                                                                            CornerRadius="{StaticResource RaioSelo}"
                                                                            Padding="8,3"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Background="{Binding SeloSituacao.ChaveFundo, Converter={x:Static vm:Conversores.Pincel}}">
                                                                        <TextBlock Text="{Binding SeloSituacao.Texto}"
                                                                                   FontSize="11" TextWrapping="Wrap"
                                                                                   HorizontalAlignment="Center"
                                                                                   Foreground="{Binding SeloSituacao.ChaveTexto, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                    </Border>

                                                                    <!-- As ações da multa num menu só: a linha já tem
                                                                         informação demais para ganhar botões soltos. -->
                                                                    <Button Grid.Column="7" Classes="atalhoicone"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            ToolTip.Tip="Ações desta multa">
                                                                        <Viewbox Width="14" Height="14">
                                                                            <Path Fill="{StaticResource TextoFraco}"
                                                                                  Stretch="Uniform"
                                                                                  Data="{StaticResource IconeMenuHamburguer}"/>
                                                                        </Viewbox>
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                <MenuItem Header="Editar multa"
                                                                                          Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).EditarMultaCommand}"
                                                                                          CommandParameter="{Binding}"/>
                                                                                <MenuItem Header="Apagar multa"
                                                                                          Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).PedirExclusaoMultaCommand}"
                                                                                          CommandParameter="{Binding}"/>
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Border IsVisible="{Binding !TemMultas}"
                                                    Background="{StaticResource Fundo}"
                                                    CornerRadius="{StaticResource RaioBotao}"
                                                    Padding="14,11">
                                                <TextBlock Text="Nenhuma multa registrada para este veículo."
                                                           FontSize="12" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextoApagado}"/>
                                            </Border>

                                            <Button Classes="atalhocartao" Content="+ registrar multa"
                                                    HorizontalAlignment="Left" Margin="-7,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).NovaMultaCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border IsVisible="{Binding SemVeiculos}" Classes="cartao" Padding="20,18">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="Nenhum veículo ligado a este cliente." FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextoFraco}"/>
                                <TextBlock Text="As multas são registradas no veículo. Cadastre o veículo para iniciar."
                                           FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextoApagado}"/>
                            </StackPanel>
                        </Border>

                        <!-- Entra tanto para o primeiro veículo quanto para mais um -->
                        <Button Classes="neutro" Content="+ Adicionar veículo"
                                HorizontalAlignment="Center" Padding="16,8"
                                IsVisible="{Binding !CarregandoVeiculos}"
                                Command="{Binding NovoVeiculoCommand}"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock IsVisible="{Binding CarregandoVeiculos}"
                           Text="Carregando os veículos..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextoFraco}"/>

                <!-- ============ ABA PROCESSOS ============
                     Um cartão por recurso, com autuação, JARI e CETRAN lado a lado.
                     As três aparecem sempre: o valor pago cobre as três, e ver o
                     caminho inteiro é o que explica em que pé está o processo. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding AbaServicos}">
                    <StackPanel Margin="24,18,24,24" Spacing="14">

                        <!-- Sub-abas: o que está correndo, o que já acabou, ou tudo -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="aba" Content="Ativos"
                                    Classes.escolhida="{Binding FiltroEmAtivos}"
                                    Command="{Binding FiltrarServicosCommand}"
                                    CommandParameter="{x:Static vm:FiltroServico.Ativos}"/>
                            <Button Classes="aba" Content="Encerrados"
                                    Classes.escolhida="{Binding FiltroEmEncerrados}"
                                    Command="{Binding FiltrarServicosCommand}"
                                    CommandParameter="{x:Static vm:FiltroServico.Encerrados}"/>
                            <Button Classes="aba" Content="Todos"
                                    Classes.escolhida="{Binding FiltroEmTodos}"
                                    Command="{Binding FiltrarServicosCommand}"
                                    CommandParameter="{x:Static vm:FiltroServico.Todos}"/>
                        </StackPanel>

                        <!-- Veio do financeiro: mostra de qual contratação é o recorte -->
                        <Border Background="{StaticResource PrimariaClara}"
                                BorderBrush="{StaticResource PrimariaBorda}" BorderThickness="1"
                                CornerRadius="{StaticResource RaioCartao}" Padding="14,10"
                                IsVisible="{Binding TemFocoDeContratacao}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimariaEscura}"
                                           Text="{Binding TituloEmFoco, StringFormat='Mostrando apenas os serviços da contratação: {0}'}"/>
                                <Button Grid.Column="1" Classes="atalhocartao" Content="ver todos"
                                        VerticalAlignment="Center"
                                        Command="{Binding LimparFocoCommand}"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Servicos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServicoDaFichaViewModel">
                                    <Border Classes="cartao" Margin="0,0,0,14">
                                        <StackPanel Spacing="12">

                                            <!-- Cabeçalho do recurso -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="titulocartao"
                                                           Text="{Binding Titulo}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            Spacing="4">
                                                    <!-- Dado digitado errado é a regra, não a exceção -->
                                                    <Button Classes="acao"
                                                            ToolTip.Tip="Corrigir o serviço ou o valor"
                                                            Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).EditarServicoCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="13" Height="13">
                                                            <Path Fill="{StaticResource Sucesso}" Stretch="Uniform"
                                                                  Data="{StaticResource IconeEditar}"/>
                                                        </Viewbox>
                                                    </Button>

                                                    <Button Classes="acao perigosa"
                                                            IsVisible="{Binding PodeCancelar}"
                                                            ToolTip.Tip="Encerrar este serviço"
                                                            Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).PedirCancelamentoCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="13" Height="13">
                                                            <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                                                  Data="{StaticResource IconeFechar}"/>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Placa, data, valor e órgão -->
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Margin="0,0,20,0"
                                                            IsVisible="{Binding TemPlaca}">
                                                    <TextBlock Text="Placa" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                    <Button Classes="copiavel placa"
                                                            Content="{Binding Placa}"
                                                            ToolTip.Tip="Copiar placa"
                                                            Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).CopiarCommand}"
                                                            CommandParameter="{Binding Placa}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Margin="0,0,20,0">
                                                    <TextBlock Text="Contratado em" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                    <TextBlock Text="{Binding ContratadoEm}" FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Texto}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Margin="0,0,20,0">
                                                    <TextBlock Text="Valor" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                    <TextBlock Text="{Binding Valor}" FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Texto}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Margin="0,0,20,0"
                                                            IsVisible="{Binding TemOrgao}">
                                                    <TextBlock Text="Órgão" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                    <TextBlock Text="{Binding Orgao}" FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Texto}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding TemAndamento}">
                                                    <TextBlock Text="Andamento" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                    <TextBlock Text="{Binding Andamento}" FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Texto}"/>
                                                </StackPanel>
                                            </WrapPanel>

                                            <!-- ======= SERVIÇO DIRETO: o roteiro de etapas =======
                                                 O mesmo cartão serve aos dois formatos. Quem anda
                                                 por etapas mostra o checklist; quem anda por fases
                                                 mostra as três instâncias, logo abaixo. -->
                                            <ItemsControl ItemsSource="{Binding Etapas}"
                                                          IsVisible="{Binding TemEtapas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EtapaViewModel">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Button Grid.Column="0" Classes="etapa"
                                                                    IsEnabled="{Binding PodeMarcar}"
                                                                    Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).MarcarEtapaCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                    <!-- O quadrado mostra o estado, não recebe o clique: quem
                                                                         marca é o botão da linha inteira. Antes ele tratava o
                                                                         próprio clique e a data não acompanhava. -->
                                                                    <CheckBox Grid.Column="0" Margin="0,0,8,0"
                                                                              IsChecked="{Binding Concluida, Mode=OneWay}"
                                                                              IsHitTestVisible="False"
                                                                              IsEnabled="{Binding PodeMarcar}"
                                                                              VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" FontSize="12.5"
                                                                               Text="{Binding Nome}"
                                                                               VerticalAlignment="Center"
                                                                               Classes.cumprida="{Binding Concluida}"
                                                                               Foreground="{StaticResource Texto}"/>

                                                                    <!-- O prazo é o que a agenda vai vigiar -->
                                                                    <Border Grid.Column="2" Margin="10,0"
                                                                            IsVisible="{Binding TemAviso}"
                                                                            CornerRadius="{StaticResource RaioSelo}"
                                                                            Padding="8,2" VerticalAlignment="Center"
                                                                            Background="{Binding FundoPrazo, Converter={x:Static vm:Conversores.Pincel}}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock Text="{Binding Prazo}" FontSize="10"
                                                                                       Foreground="{Binding CorPrazo, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                            <TextBlock Text="·" FontSize="10"
                                                                                       Foreground="{Binding CorPrazo, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                            <TextBlock Text="{Binding Aviso}" FontSize="10"
                                                                                       Foreground="{Binding CorPrazo, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <TextBlock Grid.Column="3" FontSize="11"
                                                                               Text="{Binding Quando}"
                                                                               MinWidth="72" TextAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextoApagado}"/>
                                                                </Grid>
                                                            </Button>

                                                            <Button Grid.Column="1" Classes="acao"
                                                                    Margin="6,0,0,0"
                                                                    ToolTip.Tip="Prazo e data de conclusão"
                                                                    Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).EditarEtapaCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Viewbox Width="12" Height="12">
                                                                    <Path Fill="{StaticResource TextoFraco}" Stretch="Uniform"
                                                                          Data="{StaticResource IconeEditar}"/>
                                                                </Viewbox>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- ======= RECURSO: as três fases ======= -->
                                            <ItemsControl ItemsSource="{Binding Fases}"
                                                          IsVisible="{Binding PorInstancias}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FaseViewModel">
                                                        <Border Classes="fase"
                                                                Classes.atual="{Binding Atual}"
                                                                Classes.urgente="{Binding Urgente}"
                                                                Classes.vazia="{Binding !Existe}">
                                                            <StackPanel Spacing="7">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0"
                                                                                Orientation="Horizontal" Spacing="5">
                                                                        <TextBlock Classes="nomefase"
                                                                                   Text="{Binding Numero}"/>
                                                                        <TextBlock Classes="nomefase" Text="·"/>
                                                                        <TextBlock Classes="nomefase"
                                                                                   Text="{Binding Nome}"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="1"
                                                                            CornerRadius="{StaticResource RaioSelo}"
                                                                            Padding="7,2" VerticalAlignment="Center"
                                                                            Background="{Binding FundoSituacao, Converter={x:Static vm:Conversores.Pincel}}">
                                                                        <TextBlock Text="{Binding Situacao}" FontSize="10"
                                                                                   Foreground="{Binding CorSituacao, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                    </Border>
                                                                </Grid>

                                                                <TextBlock Classes="detalhefase"
                                                                           IsVisible="{Binding TemExplicacao}"
                                                                           Text="{Binding Explicacao}"/>

                                                                <StackPanel Spacing="3" IsVisible="{Binding Existe}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                                                IsVisible="{Binding TemProtocolo}">
                                                                        <TextBlock Classes="detalhefase" Text="Protocolo"/>
                                                                        <TextBlock Classes="detalhefase"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Texto}"
                                                                                   Text="{Binding Protocolo}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                                                IsVisible="{Binding TemEnvio}">
                                                                        <TextBlock Classes="detalhefase" Text="Enviado em"/>
                                                                        <TextBlock Classes="detalhefase"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Texto}"
                                                                                   Text="{Binding EnviadoEm}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                                                IsVisible="{Binding TemResultado}">
                                                                        <TextBlock Classes="detalhefase" Text="Resultado em"/>
                                                                        <TextBlock Classes="detalhefase"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Texto}"
                                                                                   Text="{Binding ResultadoEm}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Classes="detalhefase"
                                                                               IsVisible="{Binding TemDestinatario}"
                                                                               Text="{Binding Destinatario}"/>
                                                                </StackPanel>

                                                                <Border IsVisible="{Binding TemPrazo}"
                                                                        CornerRadius="{StaticResource RaioSelo}"
                                                                        Padding="8,3" HorizontalAlignment="Left"
                                                                        Background="{Binding FundoPrazo, Converter={x:Static vm:Conversores.Pincel}}">
                                                                    <TextBlock Text="{Binding Prazo}" FontSize="10.5"
                                                                               Foreground="{Binding CorPrazo, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                                </Border>

                                                                <StackPanel Orientation="Horizontal" Spacing="7"
                                                                            Margin="0,3,0,0"
                                                                            IsVisible="{Binding TemBotao}">
                                                                    <Button Classes="primario" FontSize="11.5"
                                                                            Padding="11,6"
                                                                            Content="Registrar protocolo"
                                                                            IsVisible="{Binding PodeProtocolar}"
                                                                            Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).RegistrarProtocoloCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Classes="neutro" FontSize="11.5"
                                                                            Padding="11,6"
                                                                            Content="Registrar resultado"
                                                                            IsVisible="{Binding PodeJulgar}"
                                                                            Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).RegistrarResultadoCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Classes="cartao" IsVisible="{Binding TemEncerrados}">
                            <TextBlock Text="{Binding ResumoEncerrados}" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextoFraco}"/>
                        </Border>

                        <Border Classes="cartao" IsVisible="{Binding SemServicos}" Padding="24,28">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="Nenhum serviço contratado para este cliente." FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextoFraco}"/>
                                <TextBlock FontSize="11.5" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource TextoApagado}"
                                           Text="Todo serviço nasce de uma contratação. Use o botão + Novo serviço para registrar a primeira."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock IsVisible="{Binding CarregandoServicos}"
                           Text="Carregando os serviços..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextoFraco}"/>

                <!-- ============ ABA FINANCEIRO ============
                     Um cartão por contratação, porque é assim que o valor é combinado:
                     o desconto vale para o conjunto e o pagamento quita o conjunto. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding AbaFinanceiro}">
                    <StackPanel Margin="24,18,24,24" Spacing="14">

                        <!-- Sub-abas do financeiro -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="aba" Content="Todas"
                                    Classes.escolhida="{Binding LancamentosTodos}"
                                    Command="{Binding FiltrarLancamentosCommand}"
                                    CommandParameter="{x:Static vm:FiltroLancamento.Todas}"/>
                            <Button Classes="aba" Content="Em aberto"
                                    Classes.escolhida="{Binding LancamentosEmAberto}"
                                    Command="{Binding FiltrarLancamentosCommand}"
                                    CommandParameter="{x:Static vm:FiltroLancamento.EmAberto}"/>
                            <Button Classes="aba" Content="Quitadas"
                                    Classes.escolhida="{Binding LancamentosQuitados}"
                                    Command="{Binding FiltrarLancamentosCommand}"
                                    CommandParameter="{x:Static vm:FiltroLancamento.Quitadas}"/>
                        </StackPanel>

                        <!-- Resumo do cliente, na ordem contratado → pago → em aberto -->
                        <Border Classes="cartao">
                            <StackPanel Spacing="14">
                                <TextBlock Classes="titulocartao" Text="RESUMO DO CLIENTE"/>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,34,0">
                                        <TextBlock Text="{Binding TotalContratado}" FontSize="19"
                                                   FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                        <TextBlock Text="TOTAL CONTRATADO" FontSize="9.5"
                                                   LetterSpacing="0.5"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,34,0">
                                        <TextBlock Text="{Binding JaPago}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{StaticResource Sucesso}"/>
                                        <TextBlock Text="JÁ PAGO" FontSize="9.5" LetterSpacing="0.5"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,34,0">
                                        <TextBlock Text="{Binding EmAberto}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{StaticResource Alerta}"/>
                                        <TextBlock Text="EM ABERTO" FontSize="9.5" LetterSpacing="0.5"
                                                   Foreground="{StaticResource TextoApagado}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding PercentualQuitado}"
                                                     IsVisible="{Binding TemContratacao}"
                                                     Height="7" CornerRadius="4"
                                                     Background="{StaticResource Fundo}"
                                                     Foreground="{StaticResource Sucesso}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Uma contratação por cartão -->
                        <ItemsControl ItemsSource="{Binding Lancamentos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LancamentoDaFichaViewModel">
                                    <Border Classes="cartao" Margin="0,0,0,14">
                                        <StackPanel Spacing="12">

                                            <!-- Cabeçalho: data, situação e o caminho para os serviços -->
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding Quando, StringFormat='Contratado em {0}'}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Texto}"/>
                                                    <TextBlock Text="{Binding ResumoPagamentos}" FontSize="11.5"
                                                               Foreground="{StaticResource TextoApagado}"/>
                                                </StackPanel>

                                                <Button Grid.Column="3" Classes="atalhocartao" Content="ver serviços"
                                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                                        ToolTip.Tip="Abre a aba Serviços mostrando só os desta contratação"
                                                        IsVisible="{Binding TemServicos}"
                                                        Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).VerServicosDaContratacaoCommand}"
                                                        CommandParameter="{Binding}"/>

                                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                                        CornerRadius="{StaticResource RaioSelo}" Padding="9,3"
                                                        Background="{Binding FundoSelo, Converter={x:Static vm:Conversores.Pincel}}">
                                                    <TextBlock Text="{Binding Selo}" FontSize="11"
                                                               Foreground="{Binding CorSelo, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                </Border>

                                                <Button Grid.Column="2" Classes="primario" Content="+ Pagamento"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding Devendo}"
                                                        Command="{Binding $parent[ItemsControl].((vm:FichaClienteViewModel)DataContext).LancarPagamentoCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <!-- Os serviços cobertos, um por linha -->
                                            <ItemsControl ItemsSource="{Binding Servicos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ServicoDoLancamentoViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,5">
                                                            <TextBlock Grid.Column="0" Text="·" FontSize="12"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="{StaticResource TextoApagado}"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        Spacing="8">
                                                                <TextBlock Text="{Binding Nome}" FontSize="12.5"
                                                                           Foreground="{StaticResource Texto}"/>
                                                                <TextBlock Text="{Binding Identificacao}" FontSize="11.5"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding TemIdentificacao}"
                                                                           Foreground="{StaticResource TextoApagado}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Estado}"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       IsVisible="{Binding Encerrado}"
                                                                       Foreground="{StaticResource TextoApagado}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Os números: como se chegou ao preço, e o que falta receber.
                                                 Duas perguntas diferentes, por isso dois riscos. -->
                                            <Border Background="{StaticResource CartaoSuave}"
                                                    BorderBrush="{StaticResource BordaClara}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RaioCartao}" Padding="15,12">
                                                <StackPanel Width="330" HorizontalAlignment="Left">

                                                    <!-- O caminho até o preço. Sai inteiro quando não houve
                                                         desconto nem despesa: sozinha, a linha de serviços
                                                         repetiria o contratado. -->
                                                    <StackPanel IsVisible="{Binding TemAjustes}">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                            <TextBlock Text="Serviços" FontSize="12.5"
                                                                       Foreground="{StaticResource TextoFraco}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Tabela}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Texto}"/>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8"
                                                              IsVisible="{Binding TemDesconto}">
                                                            <TextBlock Text="Desconto" FontSize="12.5"
                                                                       Foreground="{StaticResource TextoFraco}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DescontoResumo}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Sucesso}"/>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8"
                                                              IsVisible="{Binding TemDespesas}">
                                                            <TextBlock Text="Despesas" FontSize="12.5"
                                                                       Foreground="{StaticResource TextoFraco}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DespesasResumo}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Alerta}"/>
                                                        </Grid>

                                                        <Border Height="1" Margin="0,0,0,8"
                                                                Background="{StaticResource Borda}"/>
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                        <TextBlock Text="Contratado" FontSize="12.5"
                                                                   Foreground="{StaticResource Texto}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Contratado}"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Texto}"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                        <TextBlock Text="Já pago" FontSize="12.5"
                                                                   Foreground="{StaticResource TextoFraco}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PagoResumo}"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Sucesso}"/>
                                                    </Grid>

                                                    <Border Height="1" Margin="0,0,0,8"
                                                            Background="{StaticResource Borda}"/>

                                                    <!-- Quitada mostra a palavra, não um zero: zero se lê como
                                                         campo vazio. -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="Em aberto" FontSize="12.5"
                                                                   VerticalAlignment="Bottom" Margin="0,0,0,3"
                                                                   Foreground="{StaticResource TextoFraco}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Fecho}"
                                                                   FontSize="22" FontWeight="Bold"
                                                                   Foreground="{Binding CorFecho, Converter={x:Static vm:Conversores.Pincel}}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Despesas: saem do caixa do escritório, não do que o cliente deve -->
                                            <StackPanel Spacing="8" IsVisible="{Binding TemDespesas}">
                                                <TextBlock Text="DESPESAS" FontSize="10.5" LetterSpacing="0.5"
                                                           Foreground="{StaticResource TextoApagado}"/>

                                                <ItemsControl ItemsSource="{Binding Despesas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DespesaDaFichaViewModel">
                                                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6">
                                                                <TextBlock Grid.Column="0" Text="{Binding Quando}"
                                                                           FontSize="12" Width="90"
                                                                           Foreground="{StaticResource TextoFraco}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Valor}"
                                                                           FontSize="12.5" Width="110"
                                                                           Foreground="{StaticResource Alerta}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Tipo}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource Texto}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Pagamentos lançados -->
                                            <StackPanel Spacing="8" IsVisible="{Binding TemPagamentos}">
                                                <TextBlock Text="{Binding ResumoPagamentos}" FontSize="10.5"
                                                           LetterSpacing="0.5"
                                                           Foreground="{StaticResource TextoApagado}"/>

                                                <ItemsControl ItemsSource="{Binding Pagamentos}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PagamentoDaFichaViewModel">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                                                  Margin="0,0,0,7">
                                                                <TextBlock Grid.Column="0" Text="{Binding Quando}"
                                                                           FontSize="12" Width="90"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextoFraco}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Valor}"
                                                                           FontSize="12.5" Width="110"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Sucesso}"/>
                                                                <StackPanel Grid.Column="2" Spacing="1"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Forma}" FontSize="12"
                                                                               Foreground="{StaticResource Texto}"/>
                                                                    <TextBlock Text="{Binding Observacao}" FontSize="11"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               IsVisible="{Binding TemObservacao}"
                                                                               Foreground="{StaticResource TextoApagado}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="3" Classes="atalhocartao"
                                                                        Content="apagar" VerticalAlignment="Center"
                                                                        ToolTip.Tip="Remove o lançamento e devolve o valor para em aberto"
                                                                        Command="{Binding $parent[UserControl].((vm:FichaClienteViewModel)DataContext).PedirExclusaoPagamentoCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock IsVisible="{Binding !TemPagamentos}" FontSize="12"
                                                       Text="Nenhum pagamento lançado nesta contratação."
                                                       Foreground="{StaticResource TextoApagado}"/>

                                            <TextBlock Text="{Binding Observacoes}" FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding TemObservacoes}"
                                                       Foreground="{StaticResource TextoApagado}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Classes="cartao" IsVisible="{Binding SemLancamentos}" Padding="24,28">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="Nenhuma contratação registrada para este cliente." FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextoFraco}"/>
                                <TextBlock FontSize="11.5" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource TextoApagado}"
                                           Text="O financeiro nasce da contratação. Use o botão + Novo serviço para registrar a primeira."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock IsVisible="{Binding CarregandoFinanceiro}"
                           Text="Carregando o financeiro..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextoFraco}"/>

                <TextBlock IsVisible="{Binding AbaEmConstrucao}"
                           Text="Esta aba ainda não está disponível."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextoApagado}"/>

                <TextBlock Text="Carregando..." IsVisible="{Binding Carregando}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextoFraco}"/>

                <Border IsVisible="{Binding Erro, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                        Background="{StaticResource AlertaClaro}"
                        BorderBrush="{StaticResource AlertaBorda}" BorderThickness="1"
                        CornerRadius="{StaticResource RaioCartao}" Padding="18,14"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="{Binding Erro}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource Alerta}"/>
                </Border>

            </Panel>
        </Grid>

        <!-- Formulário de veículo ou de multa, por cima da ficha inteira -->
        <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding Formulario}"
                        IsVisible="{Binding Formulario, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>

        <!-- ============ CONFIRMAÇÃO ============
             Uma só para arquivar, desvincular e apagar: quem monta a pergunta é o
             ViewModel. Cobre as duas colunas, porque nenhuma é clique de passagem. -->
        <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding Confirmacao}"
                        IsVisible="{Binding Confirmacao, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
    </Grid>
</UserControl>
