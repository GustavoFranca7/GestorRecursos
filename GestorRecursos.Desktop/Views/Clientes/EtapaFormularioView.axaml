<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             xmlns:servicos="using:GestorRecursos.Desktop.Servicos"
             mc:Ignorable="d" d:DesignWidth="1290" d:DesignHeight="880"
             x:Class="GestorRecursos.Desktop.Views.EtapaFormularioView"
             x:DataType="vm:EtapaFormularioViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.entrada">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="TextBox.entrada:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
        </Style>
        <Style Selector="TextBox.entrada.erro">
            <Setter Property="BorderBrush" Value="{StaticResource Alerta}"/>
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.erroCampo">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Alerta}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="TextBlock.dica">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoApagado}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <!-- Flutuante por cima da ficha, como as outras janelas do sistema -->
    <Border Background="#73102A2C">
        <Border Width="520" Background="{StaticResource Cartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="1"
                CornerRadius="{StaticResource RaioCartao}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True" BoxShadow="0 18 50 0 #35102A2C">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Spacing="3" Margin="26,22,26,0">
                    <TextBlock Text="Datas da etapa" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Texto}"/>
                    <TextBlock Text="{Binding Nome}" FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Texto}"/>
                    <TextBlock Text="{Binding Referencia}" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextoApagado}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="26,20,26,0" Spacing="16">
                    <StackPanel>
                        <TextBlock Classes="rotulo" Text="Prazo"/>
                        <TextBox Classes="entrada" Text="{Binding Prazo}"
                                 servicos:Mascara.Padrao="data"
                                 Classes.erro="{Binding ErroPrazo, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                 PlaceholderText="dd/mm/aaaa"/>
                        <TextBlock Classes="erroCampo" Text="{Binding ErroPrazo}"
                                   IsVisible="{Binding ErroPrazo, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                        <TextBlock Classes="dica"
                                   Text="Data limite para o cumprimento da etapa. Define o alerta de vencimento e alimenta a agenda."/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="rotulo" Text="Concluída em"/>
                        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                            <TextBox Grid.Column="0" Classes="entrada" Text="{Binding Conclusao}"
                                     servicos:Mascara.Padrao="data"
                                     Classes.erro="{Binding ErroConclusao, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                     PlaceholderText="dd/mm/aaaa"/>
                            <Button Grid.Column="2" Classes="neutro" Content="Hoje"
                                    Command="{Binding HojeCommand}"/>
                            <Button Grid.Column="4" Classes="neutro" Content="Reabrir"
                                    ToolTip.Tip="Limpa a data e devolve a etapa a pendente"
                                    Command="{Binding ReabrirCommand}"/>
                        </Grid>
                        <TextBlock Classes="erroCampo" Text="{Binding ErroConclusao}"
                                   IsVisible="{Binding ErroConclusao, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                        <TextBlock Classes="dica"
                                   Text="Com data preenchida, a etapa consta como concluída. Em branco, volta a pendente."/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ RODAPÉ ============ -->
                <Border Grid.Row="2" Background="{StaticResource CartaoSuave}"
                        BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0"
                        Padding="26,14" Margin="0,22,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Erro}" FontSize="12"
                                   Margin="0,0,16,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Alerta}"
                                   IsVisible="{Binding TemErro}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="neutro" Content="Cancelar"
                                    Command="{Binding CancelarCommand}"/>
                            <Button Classes="primario" Content="Salvar datas"
                                    IsEnabled="{Binding !Salvando}"
                                    Command="{Binding SalvarCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
