<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             xmlns:servicos="using:GestorRecursos.Desktop.Servicos"
             mc:Ignorable="d" d:DesignWidth="1290" d:DesignHeight="880"
             x:Class="GestorRecursos.Desktop.Views.MultaFormularioView"
             x:DataType="vm:MultaFormularioViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.entrada">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="TextBox.entrada:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
        </Style>
        <Style Selector="TextBox.entrada.erro">
            <Setter Property="BorderBrush" Value="{StaticResource Alerta}"/>
        </Style>
        <Style Selector="ComboBox.entrada">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.erroCampo">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Alerta}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#73102A2C">
        <Border Width="720" Background="{StaticResource Cartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="1"
                CornerRadius="{StaticResource RaioCartao}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True" BoxShadow="0 18 50 0 #35102A2C">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="26,22,26,0">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="{Binding Titulo}" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Apenas o AIT é obrigatório. Os demais campos seguem o auto de infração."
                                   FontSize="11.5" Foreground="{StaticResource TextoFraco}"/>
                    </StackPanel>

                    <!-- A multa é sempre de um carro. Quase sempre ele já está decidido;
                         na defesa de CNH, não — e aí a janela pergunta. -->
                    <Border Grid.Column="1" VerticalAlignment="Center"
                            IsVisible="{Binding !EscolheVeiculo}"
                            Background="{StaticResource PrimariaClara}"
                            BorderBrush="{StaticResource PrimariaBorda}" BorderThickness="1"
                            CornerRadius="{StaticResource RaioBotao}" Padding="11,6">
                        <TextBlock Text="{Binding Placa}" FontSize="13"
                                   FontFamily="Consolas,monospace"
                                   Foreground="{StaticResource PrimariaEscura}"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Margin="26,20,26,0">

                    <StackPanel IsVisible="{Binding EscolheVeiculo}" Margin="0,0,0,16">
                        <TextBlock Classes="rotulo" Text="Veículo *"/>
                        <ComboBox Classes="entrada" ItemsSource="{Binding Veiculos}"
                                  SelectedItem="{Binding Veiculo}"
                                  PlaceholderText="De qual carro é este auto?">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VeiculoDoServicoViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Placa}"
                                                   FontFamily="Consolas,monospace"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Descricao}"
                                                   Foreground="{StaticResource TextoFraco}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="erroCampo" Text="{Binding ErroVeiculo}"
                                   IsVisible="{Binding ErroVeiculo, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,160">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="rotulo" Text="AIT *"/>
                            <TextBox Classes="entrada" Text="{Binding Ait}"
                                     Classes.erro="{Binding ErroAit, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                     FontFamily="Consolas,monospace"
                                     Watermark="BC01267397"/>
                            <TextBlock Classes="erroCampo" Text="{Binding ErroAit}"
                                       IsVisible="{Binding ErroAit, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="rotulo" Text="Artigo do CTB"/>
                            <TextBox Classes="entrada" Text="{Binding Enquadramento}"
                                     Watermark="218 I"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Classes="rotulo" Text="Descrição da infração"/>
                        <TextBox Classes="entrada" Text="{Binding Descricao}"
                                 Watermark="Velocidade acima da máxima em até 20%"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,130,16,90" Margin="0,16,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="rotulo" Text="Local"/>
                            <TextBox Classes="entrada" Text="{Binding Local}"
                                     Watermark="Rod. Rodesindo Pavan, km 3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="rotulo" Text="Data"/>
                            <TextBox Classes="entrada" Text="{Binding Data}"
                                     servicos:Mascara.Padrao="data"
                                     Classes.erro="{Binding ErroData, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                     Watermark="dd/mm/aaaa"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Classes="rotulo" Text="Hora"/>
                            <TextBox Classes="entrada" Text="{Binding Hora}"
                                     servicos:Mascara.Padrao="hora"
                                     Watermark="09:22"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="erroCampo" Text="{Binding ErroData}"
                               IsVisible="{Binding ErroData, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>

                    <Grid ColumnDefinitions="*,16,90,16,130,16,130" Margin="0,16,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="rotulo" Text="Gravidade"/>
                            <ComboBox Classes="entrada" ItemsSource="{Binding Gravidades}"
                                      SelectedItem="{Binding Gravidade}"
                                      PlaceholderText="Selecione"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="rotulo" Text="Pontos"/>
                            <TextBox Classes="entrada" Text="{Binding Pontos}"
                                     servicos:Mascara.Padrao="numero:1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Classes="rotulo" Text="Valor"/>
                            <TextBox Classes="entrada" Text="{Binding Valor}" Watermark="130,16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Classes="rotulo" Text="Prazo de defesa"/>
                            <TextBox Classes="entrada" Text="{Binding PrazoDefesa}"
                                     servicos:Mascara.Padrao="data"
                                     Watermark="dd/mm/aaaa"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource PrimariaClara}"
                            BorderBrush="{StaticResource PrimariaBorda}" BorderThickness="1"
                            CornerRadius="{StaticResource RaioCartao}" Padding="13,11" Margin="0,18,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimariaEscura}"
                                   Text="A gravidade preenche pontos e valor pela tabela do artigo 258 do CTB. Os campos permanecem editáveis."/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource CartaoSuave}"
                        BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0"
                        Padding="26,14" Margin="0,22,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Erro}" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource Alerta}"
                                   IsVisible="{Binding TemErro}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="neutro" Content="Cancelar"
                                    Command="{Binding CancelarCommand}"/>
                            <Button Classes="primario" Content="{Binding TextoSalvar}"
                                    IsEnabled="{Binding !Salvando}"
                                    Command="{Binding SalvarCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
