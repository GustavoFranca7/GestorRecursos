<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             xmlns:modelos="using:GestorRecursos.Core.Models"
             xmlns:servicos="using:GestorRecursos.Desktop.Servicos"
             mc:Ignorable="d" d:DesignWidth="1290" d:DesignHeight="880"
             x:Class="GestorRecursos.Desktop.Views.ServicoFormularioView"
             x:DataType="vm:ServicoFormularioViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.entrada">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="TextBox.entrada:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
        </Style>
        <Style Selector="ComboBox.entrada">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.secao">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.1"/>
            <Setter Property="Foreground" Value="{StaticResource TextoApagado}"/>
        </Style>
        <Style Selector="TextBlock.dica">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoApagado}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Cada fase é um bloco; a que não pode ser preenchida esmaece -->
        <Style Selector="Border.fase">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaClara}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style Selector="Border.fase.fechada">
            <Setter Property="Background" Value="{StaticResource Fundo}"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
    </UserControl.Styles>

    <!-- Flutuante por cima da ficha, como as outras janelas do sistema -->
    <Border Background="#73102A2C">
        <Border Width="880" MaxHeight="840" Background="{StaticResource Cartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="1"
                CornerRadius="{StaticResource RaioCartao}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True" BoxShadow="0 18 50 0 #35102A2C">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Spacing="3" Margin="26,22,26,0">
                    <TextBlock Text="Editar serviço" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Texto}"/>
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,7,0,0">
                        <TextBlock Text="{Binding Referencia}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" MaxWidth="560"
                                   Foreground="{StaticResource TextoApagado}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextoApagado}">
                            <Run Text="contratado em"/>
                            <Run Text="{Binding ContratadoEm}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="26,18,26,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">

                        <TextBlock Text="Carregando os dados do serviço..." FontSize="12"
                                   IsVisible="{Binding Carregando}"
                                   Foreground="{StaticResource TextoApagado}"/>

                        <StackPanel IsVisible="{Binding Pronto}" Spacing="18">

                            <Border IsVisible="{Binding Encerrado}"
                                    Background="{StaticResource Fundo}"
                                    BorderBrush="{StaticResource BordaClara}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioCartao}" Padding="13,11">
                                <TextBlock Text="{Binding AvisoEncerrado}" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextoFraco}"/>
                            </Border>

                            <!-- ============ O SERVIÇO ============ -->
                            <StackPanel Spacing="9">
                                <TextBlock Classes="secao" Text="SERVIÇO"/>
                                <Grid ColumnDefinitions="*,16,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rotulo" Text="Serviço da tabela"/>
                                        <ComboBox Classes="entrada" ItemsSource="{Binding Servicos}"
                                                  SelectedItem="{Binding Servico}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="modelos:TipoServico">
                                                    <TextBlock Text="{Binding Nome}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="rotulo" Text="Observações da contratação"/>
                                        <TextBox Classes="entrada" Text="{Binding Observacoes}"
                                                 PlaceholderText="Condições combinadas, desconto concedido..."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ============ A MULTA ============ -->
                            <StackPanel Spacing="9" IsVisible="{Binding TemMulta}">
                                <TextBlock Classes="secao" Text="AUTO DE INFRAÇÃO"/>

                                <Grid ColumnDefinitions="*,12,140,12,150">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rotulo" Text="AIT *"/>
                                        <TextBox Classes="entrada" Text="{Binding Ait}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="rotulo" Text="Artigo do CTB"/>
                                        <TextBox Classes="entrada" Text="{Binding Enquadramento}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Classes="rotulo" Text="Gravidade"/>
                                        <ComboBox Classes="entrada" ItemsSource="{Binding Gravidades}"
                                                  SelectedItem="{Binding GravidadeMulta}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Classes="rotulo" Text="Descrição da infração"/>
                                    <TextBox Classes="entrada" Text="{Binding DescricaoMulta}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,12,140,12,140">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rotulo" Text="Local"/>
                                        <TextBox Classes="entrada" Text="{Binding LocalMulta}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="rotulo" Text="Data da infração"/>
                                        <TextBox Classes="entrada" Text="{Binding DataMulta}"
                                                 servicos:Mascara.Padrao="data"
                                                 PlaceholderText="dd/mm/aaaa"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Classes="rotulo" Text="Prazo de defesa"/>
                                        <TextBox Classes="entrada" Text="{Binding PrazoDefesa}"
                                                 servicos:Mascara.Padrao="data"
                                                 PlaceholderText="dd/mm/aaaa"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Classes="rotulo" Text="Órgão autuador"/>
                                    <TextBox Classes="entrada" Text="{Binding OrgaoAutuador}"
                                             PlaceholderText="Prefeitura de Balneário Camboriú"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ============ O PROCESSO DE CNH ============ -->
                            <StackPanel Spacing="9" IsVisible="{Binding TemProcesso}">
                                <TextBlock Classes="secao" Text="PROCESSO DO DETRAN"/>

                                <Grid ColumnDefinitions="*,12,150,12,150">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rotulo" Text="Número do processo *"/>
                                        <TextBox Classes="entrada" Text="{Binding NumeroProcesso}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="rotulo" Text="Notificação em"/>
                                        <TextBox Classes="entrada" Text="{Binding DataNotificacao}"
                                                 servicos:Mascara.Padrao="data"
                                                 PlaceholderText="dd/mm/aaaa"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Classes="rotulo" Text="Prazo de defesa"/>
                                        <TextBox Classes="entrada" Text="{Binding PrazoDoProcesso}"
                                                 servicos:Mascara.Padrao="data"
                                                 PlaceholderText="dd/mm/aaaa"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="170,12,*,12,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rotulo" Text="Tipo"/>
                                        <ComboBox Classes="entrada" ItemsSource="{Binding TiposDeProcesso}"
                                                  SelectedItem="{Binding TipoDeProcesso}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="rotulo" Text="Órgão instaurador"/>
                                        <TextBox Classes="entrada" Text="{Binding OrgaoInstaurador}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Classes="rotulo" Text="Portaria"/>
                                        <TextBox Classes="entrada" Text="{Binding Portaria}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ============ AS TRÊS FASES ============ -->
                            <StackPanel Spacing="9" IsVisible="{Binding PorInstancias}">
                                <TextBlock Classes="secao" Text="ANDAMENTO"/>
                                <TextBlock Classes="dica" Margin="0,-4,0,4"
                                           Text="As três instâncias podem ser lançadas na mesma operação. A situação de cada fase é definida pelos campos preenchidos: com resultado, julgada; com protocolo e sem resultado, aguardando julgamento."/>

                                <ItemsControl ItemsSource="{Binding Fases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FaseEditavelViewModel">
                                            <Border Classes="fase" Classes.fechada="{Binding Bloqueada}">
                                                <StackPanel Spacing="9">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Nome}"
                                                                   FontSize="11.5" FontWeight="Bold"
                                                                   LetterSpacing="0.5"
                                                                   Foreground="{StaticResource Texto}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Motivo}"
                                                                   FontSize="11" Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding TemMotivo}"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                    </Grid>

                                                    <StackPanel Spacing="9" IsVisible="{Binding Liberada}">
                                                        <Grid ColumnDefinitions="130,12,*,12,130">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Classes="rotulo" Text="Prazo"/>
                                                                <TextBox Classes="entrada" Text="{Binding Prazo}"
                                                                         servicos:Mascara.Padrao="data"
                                                                         PlaceholderText="dd/mm/aaaa"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Classes="rotulo" Text="Número do protocolo"/>
                                                                <TextBox Classes="entrada" Text="{Binding Protocolo}"
                                                                         PlaceholderText="2026/88213"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Classes="rotulo" Text="Enviado em"/>
                                                                <TextBox Classes="entrada" Text="{Binding Enviado}"
                                                                         servicos:Mascara.Padrao="data"
                                                                         PlaceholderText="dd/mm/aaaa"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,12,150,12,130">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Classes="rotulo" Text="Destinatário"/>
                                                                <TextBox Classes="entrada" Text="{Binding Destinatario}"
                                                                         PlaceholderText="Destinatário do recurso"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Classes="rotulo" Text="Resultado"/>
                                                                <ComboBox Classes="entrada"
                                                                          ItemsSource="{Binding Resultados}"
                                                                          SelectedItem="{Binding Resultado}"
                                                                          PlaceholderText="sem decisão"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Classes="rotulo" Text="Julgado em"/>
                                                                <TextBox Classes="entrada" Text="{Binding Julgado}"
                                                                         servicos:Mascara.Padrao="data"
                                                                         PlaceholderText="dd/mm/aaaa"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ RODAPÉ ============ -->
                <Border Grid.Row="2" Background="{StaticResource CartaoSuave}"
                        BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0"
                        Padding="26,14" Margin="0,18,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Erro}" FontSize="12"
                                   Margin="0,0,16,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Alerta}"
                                   IsVisible="{Binding TemErro}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="neutro" Content="Cancelar"
                                    Command="{Binding CancelarCommand}"/>
                            <Button Classes="primario" Content="Salvar"
                                    IsEnabled="{Binding !Salvando}"
                                    Command="{Binding SalvarCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
