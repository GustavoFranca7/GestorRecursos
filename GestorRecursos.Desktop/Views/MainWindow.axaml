<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
        xmlns:ctl="using:GestorRecursos.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="GestorRecursos.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        FontFamily="{StaticResource FontePixel}"
        FontSize="16"
        Background="{StaticResource PretoAzulado}"
        Title="Gerenciador de Clientes">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Estado normal da linha. Transparente, mas nao nulo: sem cor de
             fundo a Border nao recebe o mouse. -->
        <Style Selector="Border.linha">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.linha > Grid > SelectableTextBlock">
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource CinzaClaro}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="{x:Static ctl:Corte.TresPontos}" />
        </Style>
        <Style Selector="Border.linha > Grid > SelectableTextBlock.fraco">
            <Setter Property="Foreground" Value="{StaticResource Sage}" />
        </Style>
        <Style Selector="Border.linha > Grid > SelectableTextBlock.email">
            <Setter Property="Foreground" Value="{StaticResource AzulAco}" />
        </Style>

        <!-- Linha marcada na caixinha. Vem antes do realce do mouse, que tem prioridade. -->
        <Style Selector="Border.linha.selecionada">
            <Setter Property="Background" Value="{StaticResource VerdeProfundo}" />
        </Style>
        <Style Selector="Border.linha.selecionada > Grid > SelectableTextBlock.fraco">
            <Setter Property="Foreground" Value="{StaticResource Areia}" />
        </Style>
        <Style Selector="Border.linha.selecionada > Grid > SelectableTextBlock.email">
            <Setter Property="Foreground" Value="{StaticResource CinzaClaro}" />
        </Style>

        <!-- Linha sob o mouse ou com o endereco aberto. O ">" limita aos textos
             da propria linha, para nao mexer no texto de dentro dos botoes. -->
        <Style Selector="Border.linha:pointerover, Border.linha.aberta">
            <Setter Property="Background" Value="{StaticResource Sage}" />
        </Style>
        <Style Selector="Border.linha:pointerover > Grid > SelectableTextBlock, Border.linha.aberta > Grid > SelectableTextBlock">
            <Setter Property="Foreground" Value="{StaticResource PretoAzulado}" />
        </Style>

        <!-- Setinha com a arte do botao escuro pressionado quando o endereco esta aberto -->
        <Style Selector="Border.linha.aberta Button.seta /template/ ctl|NineSlice#Fundo">
            <Setter Property="Source" Value="/Assets/UI/botao-escuro-press.png" />
        </Style>

        <!-- Numero da pagina que esta na tela fica verde -->
        <Style Selector="Button.atual /template/ ctl|NineSlice#Fundo">
            <Setter Property="Source" Value="/Assets/UI/botao-verde-normal.png" />
        </Style>
        <Style Selector="Button.atual">
            <Setter Property="Foreground" Value="{StaticResource QuaseBranco}" />
        </Style>

        <!-- Texto selecionado na lista (para copiar) -->
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="{StaticResource AzulAco}" />
            <!-- Recebe o foco ao clicar: sem foco, o Ctrl+C do teclado nao chega ate o texto -->
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Titulos do cabecalho -->
        <Style Selector="TextBlock.titulo">
            <Setter Property="Foreground" Value="{StaticResource Sage}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Barrinhas entre as colunas: todas da mesma cor; so as que arrastam acendem com o mouse -->
        <Style Selector="ctl|DivisorColuna">
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style Selector="ctl|DivisorColuna > Border">
            <Setter Property="Background" Value="{StaticResource Sage}" />
        </Style>
        <Style Selector="ctl|DivisorColuna.ativo:pointerover > Border">
            <Setter Property="Background" Value="{StaticResource Mostarda}" />
        </Style>
        <!-- Toda moldura usa a mesma regra de corte. -->
        <Style Selector="ctl|NineSlice.moldura">
            <Setter Property="Slice" Value="8" />
            <Setter Property="Escala" Value="2" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid ColumnDefinitions="130,8,*" Margin="8">

            <!-- ===================== MENU LATERAL ===================== -->
            <Panel Grid.Column="0">
                <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-escura.png" />
                <DockPanel Margin="8,16">
                    <TextBlock DockPanel.Dock="Bottom" Text="V1.1 · OK"
                               Foreground="{StaticResource OlivaEscuro}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Spacing="6">
                        <!-- Provisorio: blocos coloridos no lugar dos icones,
                             ate a arte de 64x64 ficar pronta. -->
                        <StackPanel Background="{StaticResource Mostarda}">
                            <Border Width="64" Height="64" Margin="0,8,0,4"
                                    Background="{StaticResource Verde}"
                                    BorderBrush="{StaticResource PretoAzulado}" BorderThickness="3" />
                            <TextBlock Text="CLIENTES" Foreground="{StaticResource PretoAzulado}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8" />
                        </StackPanel>
                        <StackPanel>
                            <Border Width="64" Height="64" Margin="0,8,0,4"
                                    Background="{StaticResource Marrom}"
                                    BorderBrush="{StaticResource PretoAzulado}" BorderThickness="3" />
                            <TextBlock Text="RELATORIOS" Foreground="{StaticResource CinzaClaro}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Panel>

            <!-- ===================== CONTEUDO ===================== -->
            <Grid Grid.Column="2" RowDefinitions="Auto,8,*">

                <!-- Barra do topo: titulo, busca e acoes -->
                <Panel Grid.Row="0">
                    <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-escura.png" />
                    <Grid ColumnDefinitions="Auto,*,Auto,16,Auto,12,Auto,8,Auto,8,Auto" Margin="16,10">
                        <TextBlock Grid.Column="0" Text="CLIENTES" FontSize="32"
                                   Foreground="{StaticResource CinzaClaro}" VerticalAlignment="Center" />

                        <!-- Quantos clientes estao marcados (some quando nenhum) -->
                        <TextBlock Grid.Column="2" Text="{Binding TextoSelecionados}"
                                   Foreground="{StaticResource Mostarda}" VerticalAlignment="Center" />

                        <!-- Lixeira: exclui os marcados. Apagada enquanto nada estiver marcado. -->
                        <Button Grid.Column="4" Classes="icone" ToolTip.Tip="Excluir selecionados"
                                Theme="{StaticResource BotaoVinho}"
                                Command="{Binding ExcluirSelecionadosCommand}">
                            <Panel>
                                <ctl:IconePixel Classes="normal" Source="/Assets/Icons/lixeira-normal.png" />
                                <ctl:IconePixel Classes="hover" Source="/Assets/Icons/lixeira-hover.png" />
                            </Panel>
                        </Button>

                        <!-- Campo de busca: a moldura clara vai atras do TextBox,
                             que fica sem fundo e sem borda propria. -->
                        <Panel Grid.Column="6" Width="230" Height="40">
                            <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-clara.png" />
                            <TextBox Classes="pixel" Watermark="Buscar nome ou CPF..."
                                     FontFamily="{StaticResource FontePixel}" FontSize="16"
                                     VerticalContentAlignment="Center" Margin="14,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource CinzaClaro}" CornerRadius="0" />
                        </Panel>

                        <Button Grid.Column="8" Classes="icone" ToolTip.Tip="Atualizar lista"
                                Theme="{StaticResource BotaoEscuro}"
                                Command="{Binding CarregarClientesCommand}">
                            <Panel>
                                <ctl:IconePixel Classes="normal" Source="/Assets/Icons/atualizar-normal.png" />
                                <ctl:IconePixel Classes="hover" Source="/Assets/Icons/atualizar-hover.png" />
                            </Panel>
                        </Button>

                        <!-- Botao escuro: o verde do icone some em cimaclk da arte verde -->
                        <Button Grid.Column="10" Classes="icone" ToolTip.Tip="Novo cliente"
                                Theme="{StaticResource BotaoEscuro}"
                                Command="{Binding AbrirNovoClienteCommand}">
                            <Panel>
                                <ctl:IconePixel Classes="normal" Source="/Assets/Icons/mais-normal.png" />
                                <ctl:IconePixel Classes="hover" Source="/Assets/Icons/mais-hover.png" />
                            </Panel>
                        </Button>
                    </Grid>
                </Panel>

                <!-- Painel da lista -->
                <Panel Grid.Row="2">
                    <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-escura.png" />
                    <DockPanel Margin="14,12">

                        <!-- Caminho -->
                        <Panel DockPanel.Dock="Top" Height="34">
                            <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-clara.png" />
                            <TextBlock Text="/CLIENTES/LISTA" Margin="14,0"
                                       Foreground="{StaticResource CinzaClaro}" VerticalAlignment="Center" />
                        </Panel>

                        <!-- ============ Rodape: paginacao ============ -->
                        <Panel DockPanel.Dock="Bottom" Height="50" Margin="0,8,0,0">
                            <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-clara.png" />
                            <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,16,*,Auto,8,Auto"
                                  Margin="12,0" VerticalAlignment="Center">

                                <Button Grid.Column="0" Content="&lt; ANTERIOR"
                                        Theme="{StaticResource BotaoLinhaEscuro}"
                                        Command="{Binding PaginaAnteriorCommand}" />

                                <Button Grid.Column="2" Content="&lt;&lt;" ToolTip.Tip="Primeira pagina"
                                        Theme="{StaticResource BotaoLinhaEscuro}"
                                        Command="{Binding PrimeiraPaginaCommand}" />

                                <!-- Ate 3 botoes numerados, que andam junto com a pagina atual -->
                                <ItemsControl Grid.Column="4" ItemsSource="{Binding NumerosPagina}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaginaBotao">
                                            <!-- O comando mora no MainViewModel, entao a ligacao sobe ate a lista -->
                                            <Button Content="{Binding Numero}" Classes.atual="{Binding Atual}"
                                                    Theme="{StaticResource BotaoLinhaEscuro}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).IrParaPaginaCommand}"
                                                    CommandParameter="{Binding Numero}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Column="6" Content="&gt;&gt;" ToolTip.Tip="Ultima pagina"
                                        Theme="{StaticResource BotaoLinhaEscuro}"
                                        Command="{Binding UltimaPaginaCommand}" />

                                <Button Grid.Column="8" Content="PROXIMA &gt;"
                                        Theme="{StaticResource BotaoLinhaEscuro}"
                                        Command="{Binding ProximaPaginaCommand}" />

                                <TextBlock Grid.Column="10" Text="{Binding Status}" VerticalAlignment="Center"
                                           TextTrimming="{x:Static ctl:Corte.TresPontos}"
                                           Foreground="{StaticResource Sage}" />

                                <TextBlock Grid.Column="11" Text="POR PAGINA" VerticalAlignment="Center"
                                           Foreground="{StaticResource Sage}" />

                                <!-- Lista de 10 a 100: escolhe quantos clientes aparecem por pagina -->
                                <ComboBox Grid.Column="13" Classes="pixel" Width="74" Padding="8,0"
                                          ItemsSource="{Binding TamanhosPagina}"
                                          SelectedItem="{Binding TamanhoPagina}" />
                            </Grid>
                        </Panel>

                        <!-- Cabecalho das colunas. As larguras precisam bater com as da linha, la embaixo:
                             NOME, E-MAIL e CIDADE vem do ViewModel (arrastaveis); as outras sao fixas. -->
                        <Panel DockPanel.Dock="Top" Height="34" Margin="0,4,0,4">
                            <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-clara.png" />
                            <!-- Segue a rolagem horizontal da lista. A margem da direita e o espaco
                                 da barra de rolagem vertical, que a lista tem e o cabecalho nao. -->
                            <ScrollViewer Margin="0,0,14,0" Offset="{Binding #ListaRolagem.Offset, Mode=OneWay}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <Grid ColumnDefinitions="44,60,Auto,120,Auto,Auto,110,100,96,22,*" Margin="14,0,8,0">
                                    <Panel Grid.Column="1">
                                        <TextBlock Classes="titulo" Text="ID" />
                                        <ctl:DivisorColuna PodeRedimensionar="False" />
                                    </Panel>
                                    <Panel Grid.Column="2" Width="{Binding LarguraNome}">
                                        <TextBlock Classes="titulo" Text="NOME" />
                                        <ctl:DivisorColuna Largura="{Binding LarguraNome}" Minimo="80" Maximo="600" />
                                    </Panel>
                                    <Panel Grid.Column="3">
                                        <TextBlock Classes="titulo" Text="CPF" />
                                        <ctl:DivisorColuna PodeRedimensionar="False" />
                                    </Panel>
                                    <Panel Grid.Column="4" Width="{Binding LarguraEmail}">
                                        <TextBlock Classes="titulo" Text="E-MAIL" />
                                        <ctl:DivisorColuna Largura="{Binding LarguraEmail}" Minimo="80" Maximo="600" />
                                    </Panel>
                                    <Panel Grid.Column="5" Width="{Binding LarguraCidade}">
                                        <TextBlock Classes="titulo" Text="CIDADE" />
                                        <ctl:DivisorColuna Largura="{Binding LarguraCidade}" Minimo="80" Maximo="400" />
                                    </Panel>
                                    <Panel Grid.Column="6">
                                        <TextBlock Classes="titulo" Text="TELEFONE" />
                                        <ctl:DivisorColuna PodeRedimensionar="False" />
                                    </Panel>
                                    <Panel Grid.Column="7">
                                        <TextBlock Classes="titulo" Text="CADASTRO" />
                                        <ctl:DivisorColuna PodeRedimensionar="False" />
                                    </Panel>
                                    <Panel Grid.Column="8">
                                        <TextBlock Classes="titulo" Text="ACOES" />
                                        <ctl:DivisorColuna PodeRedimensionar="False" />
                                    </Panel>
                                    <!-- Marca ou desmarca todos os clientes da pagina -->
                                    <CheckBox Grid.Column="9" Theme="{StaticResource CaixaPixel}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip.Tip="Marcar todos da pagina"
                                              IsChecked="{Binding TodosSelecionados}" />
                                </Grid>
                            </ScrollViewer>
                        </Panel>

                        <!-- Rolagem simples, sem arte por enquanto. A vertical fica sempre no lugar para as
                             colunas nao sairem do alinhamento com o cabecalho; a horizontal so aparece
                             quando as colunas alargadas nao cabem mais na tela. -->
                        <ScrollViewer Name="ListaRolagem" AllowAutoHide="False"
                                      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Clientes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClienteItemViewModel">
                                        <StackPanel>
                                            <!-- Linha do cliente. As cores ficam nos estilos la em cima, senao o realce
                                                 do mouse nao consegue sobrescrever. SelectableTextBlock deixa
                                                 selecionar o texto e copiar (Ctrl+C ou botao direito). -->
                                            <Border Classes="linha" Classes.aberta="{Binding Expandido}"
                                                    Classes.selecionada="{Binding Selecionado}"
                                                    BorderBrush="{StaticResource PretoAzulado}" BorderThickness="0,0,0,2"
                                                    Padding="14,5,8,5">
                                                <Grid ColumnDefinitions="44,60,Auto,120,Auto,Auto,110,100,96,22,*">
                                                    <Button Grid.Column="0" Classes="seta" Content="{Binding Seta}"
                                                            ToolTip.Tip="Ver endereco"
                                                            Theme="{StaticResource BotaoLinhaEscuro}"
                                                            Width="32" MinWidth="32" Padding="0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding AlternarCommand}" />
                                                    <SelectableTextBlock Grid.Column="1" Classes="fraco" Text="{Binding Cliente.Id}" />
                                                    <!-- Colunas arrastaveis: a largura vem do MainViewModel, la da lista -->
                                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Cliente.Nome}"
                                                                         Width="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LarguraNome}" />
                                                    <SelectableTextBlock Grid.Column="3" Text="{Binding Cliente.Cpf}" />
                                                    <SelectableTextBlock Grid.Column="4" Classes="email" Text="{Binding Cliente.Email}"
                                                                         Width="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LarguraEmail}" />

                                                    <!-- Etiqueta da cidade (fica fora do realce do mouse) -->
                                                    <Panel Grid.Column="5"
                                                           Width="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LarguraCidade}">
                                                        <Border IsVisible="{Binding TemEndereco}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Background="{StaticResource AzulAco}"
                                                                BorderBrush="{StaticResource PretoAzulado}" BorderThickness="2"
                                                                Padding="6,0" Margin="0,0,8,0">
                                                            <SelectableTextBlock Text="{Binding CidadeUf}"
                                                                                 TextTrimming="{x:Static ctl:Corte.TresPontos}"
                                                                                 Foreground="{StaticResource QuaseBranco}" />
                                                        </Border>
                                                    </Panel>

                                                    <SelectableTextBlock Grid.Column="6" Text="{Binding Cliente.Telefone}" />
                                                    <SelectableTextBlock Grid.Column="7"
                                                                         Text="{Binding Cliente.DataCadastro, StringFormat={}{0:dd/MM/yyyy}}" />
                                                    <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
                                                        <!-- Abre o formulario com os dados desta linha -->
                                                        <Button Content="E" ToolTip.Tip="Editar"
                                                                Theme="{StaticResource BotaoLinhaEscuro}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AbrirEdicaoCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <!-- Pergunta antes de excluir este cliente -->
                                                        <Button Content="X" ToolTip.Tip="Excluir"
                                                                Theme="{StaticResource BotaoLinhaVinho}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PedirExclusaoCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <!-- Caixinha para excluir varios de uma vez -->
                                                    <CheckBox Grid.Column="9" Theme="{StaticResource CaixaPixel}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsChecked="{Binding Selecionado}" />
                                                </Grid>
                                            </Border>

                                            <!-- Endereco: so aparece com a setinha aberta -->
                                            <Border IsVisible="{Binding Expandido}"
                                                    Background="{StaticResource PretoAzulado}" Padding="58,10,14,10">
                                                <Panel>
                                                    <StackPanel Orientation="Horizontal" Spacing="26"
                                                                IsVisible="{Binding TemEndereco}">
                                                        <Border Width="4" Background="{StaticResource Verde}" />
                                                        <SelectableTextBlock>
                                                            <Run Text="LOGRADOURO " Foreground="{StaticResource Sage}" />
                                                            <Run Text="{Binding Cliente.Endereco.Logradouro}" Foreground="{StaticResource CinzaClaro}" />
                                                        </SelectableTextBlock>
                                                        <SelectableTextBlock>
                                                            <Run Text="NUMERO " Foreground="{StaticResource Sage}" />
                                                            <Run Text="{Binding Cliente.Endereco.Numero}" Foreground="{StaticResource CinzaClaro}" />
                                                        </SelectableTextBlock>
                                                        <SelectableTextBlock>
                                                            <Run Text="CIDADE " Foreground="{StaticResource Sage}" />
                                                            <Run Text="{Binding Cliente.Endereco.Cidade}" Foreground="{StaticResource CinzaClaro}" />
                                                        </SelectableTextBlock>
                                                        <SelectableTextBlock>
                                                            <Run Text="UF " Foreground="{StaticResource Sage}" />
                                                            <Run Text="{Binding Cliente.Endereco.Estado}" Foreground="{StaticResource CinzaClaro}" />
                                                        </SelectableTextBlock>
                                                        <SelectableTextBlock>
                                                            <Run Text="CEP " Foreground="{StaticResource Sage}" />
                                                            <Run Text="{Binding Cliente.Endereco.Cep}" Foreground="{StaticResource CinzaClaro}" />
                                                        </SelectableTextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="Cliente sem endereco cadastrado."
                                                               Foreground="{StaticResource Sage}"
                                                               IsVisible="{Binding !TemEndereco}" />
                                                </Panel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </Grid>
        </Grid>

        <!-- Formulario de cliente (novo ou edicao), por cima de tudo. O ViewLocator escolhe
             a tela (FormularioClienteView) a partir do ViewModel. -->
        <ContentControl Content="{Binding Formulario}"
                        IsVisible="{Binding Formulario, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Confirmacao de exclusao (ConfirmacaoExclusaoView), tambem por cima de tudo -->
        <ContentControl Content="{Binding Confirmacao}"
                        IsVisible="{Binding Confirmacao, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Aviso rapido no canto inferior esquerdo: some sozinho em 3 s,
             mas continua na tela enquanto o mouse estiver em cima. -->
        <ctl:Notificacao Texto="{Binding Notificacao}" Background="Transparent"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="16" MaxWidth="380">
            <Panel>
                <ctl:NineSlice Classes="moldura" Source="/Assets/UI/moldura-escura.png" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,12">
                    <Border Width="12" Height="12" VerticalAlignment="Center"
                            Background="{StaticResource Verde}"
                            BorderBrush="{StaticResource PretoAzulado}" BorderThickness="2" />
                    <TextBlock Text="{Binding Notificacao}" TextWrapping="Wrap" MaxWidth="310"
                               Foreground="{StaticResource QuaseBranco}" VerticalAlignment="Center" />
                </StackPanel>
            </Panel>
        </ctl:Notificacao>
    </Panel>
</Window>
