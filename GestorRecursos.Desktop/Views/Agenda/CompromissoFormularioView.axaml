<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GestorRecursos.Desktop.ViewModels"
             xmlns:servicos="using:GestorRecursos.Desktop.Servicos"
             mc:Ignorable="d" d:DesignWidth="1290" d:DesignHeight="880"
             x:Class="GestorRecursos.Desktop.Views.CompromissoFormularioView"
             x:DataType="vm:CompromissoFormularioViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.entrada">
            <Setter Property="Background" Value="{StaticResource Cartao}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RaioBotao}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="TextBox.entrada:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Primaria}"/>
        </Style>
        <Style Selector="TextBox.entrada.erro">
            <Setter Property="BorderBrush" Value="{StaticResource Alerta}"/>
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.erroCampo">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Alerta}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="ComboBox.entrada">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Um cliente na lista de escolha -->
        <Style Selector="Button.escolha">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaClara}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.escolha /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.escolha:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#73102A2C">
        <Border Width="580" MaxHeight="700" Background="{StaticResource Cartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="1"
                CornerRadius="{StaticResource RaioCartao}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True" BoxShadow="0 18 50 0 #35102A2C">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Spacing="3" Margin="26,22,26,0">
                    <TextBlock Text="{Binding TituloDaJanela}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Texto}"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextoFraco}"
                               Text="{Binding Explicacao}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Margin="26,18,26,0">
                    <StackPanel Spacing="14">

                        <!-- ===== ESCOLHA DO CLIENTE, quando aberta ===== -->
                        <StackPanel Spacing="8" IsVisible="{Binding EscolhendoCliente}">
                            <TextBlock Classes="rotulo" Text="De quem é"/>
                            <TextBox Classes="busca" Text="{Binding TermoBusca}"
                                     PlaceholderText="Buscar por nome ou CPF"/>

                            <Border BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioBotao}"
                                    MaxHeight="270" ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Clientes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EscolhaDeClienteViewModel">
                                                <Button Classes="escolha"
                                                        Command="{Binding $parent[ItemsControl].((vm:CompromissoFormularioViewModel)DataContext).EscolherCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Nome}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Texto}"/>
                                                        <TextBlock Text="{Binding Cpf}" FontSize="11"
                                                                   Foreground="{StaticResource TextoApagado}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <TextBlock IsVisible="{Binding SemClientes}" FontSize="12"
                                       Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextoFraco}"
                                       Text="Nenhum cliente encontrado."/>

                            <Button Classes="atalhocartao" Content="deixar sem cliente"
                                    HorizontalAlignment="Center"
                                    Command="{Binding TirarClienteCommand}"/>
                        </StackPanel>

                        <!-- ===== O COMPROMISSO ===== -->
                        <StackPanel Spacing="14" IsVisible="{Binding !EscolhendoCliente}">

                            <StackPanel>
                                <TextBlock Classes="rotulo" Text="O que é *"/>
                                <TextBox Classes="entrada" Text="{Binding Titulo}"
                                         Classes.erro="{Binding ErroTitulo, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                         PlaceholderText="Atendimento presencial, imprimir e-mails..."/>
                                <TextBlock Classes="erroCampo" Text="{Binding ErroTitulo}"
                                           IsVisible="{Binding ErroTitulo, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,14,*,14,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="rotulo" Text="Data *"/>
                                    <TextBox Classes="entrada" Text="{Binding Data}"
                                             servicos:Mascara.Padrao="data"
                                             Classes.erro="{Binding ErroData, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                             PlaceholderText="dd/mm/aaaa"/>
                                    <TextBlock Classes="erroCampo" Text="{Binding ErroData}"
                                               IsVisible="{Binding ErroData, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                                </StackPanel>
                                <!-- Hora é opcional: tarefa do dia não tem horário -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="rotulo" Text="Hora"/>
                                    <TextBox Classes="entrada" Text="{Binding Hora}"
                                             Classes.erro="{Binding ErroHora, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                             PlaceholderText="hh:mm"/>
                                    <TextBlock Classes="erroCampo" Text="{Binding ErroHora}"
                                               IsVisible="{Binding ErroHora, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Classes="rotulo" Text="Tipo *"/>
                                    <ComboBox Classes="entrada" ItemsSource="{Binding Tipos}"
                                              SelectedItem="{Binding TipoEscolhido}"/>
                                </StackPanel>
                            </Grid>

                            <!-- "Outro" sozinho não diz nada: é ele que vira o selo na lista -->
                            <StackPanel IsVisible="{Binding PedeOTipo}">
                                <TextBlock Classes="rotulo" Text="Que tipo de compromisso *"/>
                                <TextBox Classes="entrada" Text="{Binding TipoOutro}"
                                         MaxLength="40"
                                         Classes.erro="{Binding ErroTipoOutro, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                         PlaceholderText="Cartório, perícia, audiência..."/>
                                <TextBlock Classes="erroCampo" Text="{Binding ErroTipoOutro}"
                                           IsVisible="{Binding ErroTipoOutro, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="rotulo" Text="De quem é"/>
                                <Border Background="{StaticResource Fundo}"
                                        CornerRadius="{StaticResource RaioBotao}" Padding="13,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2"
                                                    IsVisible="{Binding TemCliente}">
                                            <TextBlock Text="{Binding Cliente.Nome}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Texto}"/>
                                            <TextBlock Text="{Binding Cliente.Cpf}" FontSize="11"
                                                       Foreground="{StaticResource TextoApagado}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="0" FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !TemCliente}"
                                                   Foreground="{StaticResource TextoApagado}"
                                                   Text="Sem cliente — é uma tarefa do escritório"/>
                                        <Button Grid.Column="1" Classes="atalhocartao"
                                                Content="escolher" VerticalAlignment="Center"
                                                Command="{Binding AbrirEscolhaDeClienteCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="rotulo" Text="Repete"/>
                                <ComboBox Classes="entrada" ItemsSource="{Binding Recorrencias}"
                                          SelectedItem="{Binding RecorrenciaEscolhida}"
                                          IsVisible="{Binding PodeTrocarRitmo}"/>

                                <!-- Alterando, o ritmo é só informação: a série já existe -->
                                <Border Background="{StaticResource Fundo}"
                                        CornerRadius="{StaticResource RaioBotao}" Padding="13,11"
                                        IsVisible="{Binding !PodeTrocarRitmo}">
                                    <TextBlock Text="{Binding RecorrenciaEscolhida}" FontSize="12.5"
                                               Foreground="{StaticResource TextoFraco}"/>
                                </Border>

                                <!-- RF-31: a série inteira é gravada de uma vez, para o mês
                                     mostrar carga futura de verdade -->
                                <Grid ColumnDefinitions="150,14,*" Margin="0,10,0,0"
                                      IsVisible="{Binding PedeAteQuando}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rotulo" Text="Repete até *"/>
                                        <TextBox Classes="entrada" Text="{Binding RepeteAte}"
                                                 servicos:Mascara.Padrao="data"
                                                 Classes.erro="{Binding ErroRepeteAte, Converter={x:Static vm:Conversores.NaoEhNulo}}"
                                                 PlaceholderText="dd/mm/aaaa"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Previsao}"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               VerticalAlignment="Bottom" Margin="0,0,0,12"
                                               Foreground="{StaticResource TextoApagado}"/>
                                </Grid>

                                <TextBlock Classes="erroCampo" Text="{Binding ErroRepeteAte}"
                                           IsVisible="{Binding ErroRepeteAte, Converter={x:Static vm:Conversores.NaoEhNulo}}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="rotulo" Text="Observação"/>
                                <TextBox Classes="entrada" Text="{Binding Observacao}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                         PlaceholderText="O que mais precisa ser lembrado"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource Fundo}"
                        BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0"
                        Padding="26,16" Margin="0,18,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Erro}" FontSize="11.5"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{Binding TemErro}"
                                   Foreground="{StaticResource Alerta}"/>
                        <Button Grid.Column="1" Classes="neutro" Content="Cancelar"
                                Padding="16,8" Margin="0,0,8,0"
                                Command="{Binding CancelarCommand}"/>
                        <Button Grid.Column="2" Classes="primario" Content="{Binding TextoDoBotao}"
                                Padding="16,8" IsEnabled="{Binding !Salvando}"
                                Command="{Binding SalvarCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
